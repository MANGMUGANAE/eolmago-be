          '<p class="detail-comment-meta"><span class="name">' + escapeHtml(c.evaluatorName) + '</span><span class="time">' + escapeHtml(formatDateTime(c.createdAt)) + '</span></p>' +
          '<p class="detail-comment-text">' + escapeHtml(c.content) + '</p>' +
