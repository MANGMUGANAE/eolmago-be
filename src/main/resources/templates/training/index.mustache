  function shortsIsDesktop() {
    return window.matchMedia('(min-width: 768px)').matches;
  }

  function shortsAxisProp() {
    return shortsIsDesktop() ? 'translateX' : 'translateY';
  }

  function shortsAxisPoint(touch) {
    return shortsIsDesktop() ? touch.clientX : touch.clientY;
  }

  function onShortsBackdropClick(event) {
    if (event.target.id === 'shortsOverlay' && backdropMouseDownOnSelf) closeShorts();
  }

  function currentShortsItem() {
    return shortsQueue[shortsIndex];
  }

  function renderShortsCard(item) {
    closeShortsCriteria();
    document.getElementById('shortsProgress').textContent = '평가 ' + item.evaluationCount + '/3';
    document.getElementById('shortsTitle').innerHTML = '<span class="id-tag">#' + item.id + '</span>' + escapeHtml(item.title);
    document.getElementById('shortsContent').textContent = item.content;

    const sourceBtn = document.getElementById('shortsSourceBtn');
    if (item.sourceUrl && /^https?:\/\//i.test(item.sourceUrl)) {
      sourceBtn.classList.remove('hidden');
      sourceBtn.dataset.url = item.sourceUrl;
    } else {
      sourceBtn.classList.add('hidden');
    }

    renderShortsHeart(item);
    document.getElementById('shortsCommentCount').textContent = item.commentCount || 0;
    document.getElementById('shortsCard').scrollTop = 0;
  }

  function renderShortsHeart(item) {
    const btn = document.getElementById('shortsHeartBtn');
    const icon = btn.querySelector('.shorts-heart-icon');
    if (item.myLabel === null || item.myLabel === undefined) {
      btn.removeAttribute('data-label');
      icon.textContent = '♡';
    } else {
      btn.dataset.label = String(item.myLabel);
      icon.textContent = '♥';
    }
  }

  async function toggleShortsHeart() {
    const item = currentShortsItem();
    if (!item) return;
    const nextLabel = (item.myLabel === null || item.myLabel === undefined) ? 0 : (item.myLabel + 1) % 3;

    if (item.myEvaluationId == null) {
      const json = await api('/training/api/posts/' + item.id + '/evaluations', {
        method: 'POST', body: JSON.stringify({ label: nextLabel })
      });
      if (json.data && json.data.success === false) {
        toast(json.data.message);
        return;
      }
      item.myEvaluationId = json.data.evaluationId;
      item.evaluationCount = json.data.post.evaluationCount;
    } else {
      await api('/training/api/evaluations/' + item.myEvaluationId, {
        method: 'PUT', body: JSON.stringify({ label: nextLabel })
      });
    }
    item.myLabel = nextLabel;
    renderShortsHeart(item);
    document.getElementById('shortsProgress').textContent = '평가 ' + item.evaluationCount + '/3';
    showShortsLabelToast(nextLabel);

    const heartBtn = document.getElementById('shortsHeartBtn');
    heartBtn.classList.remove('active');
    requestAnimationFrame(() => {
      heartBtn.classList.add('active');
      setTimeout(() => heartBtn.classList.remove('active'), 220);
    });
  }

  function showShortsLabelToast(label) {
    const el = document.getElementById('shortsLabelToast');
    el.textContent = label === 0 ? '정상글' : (label === 1 ? '광고글' : '애매함');
    el.classList.add('show');
    clearTimeout(shortsLabelToastTimer);
    shortsLabelToastTimer = setTimeout(() => el.classList.remove('show'), 900);
  }

