<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>핫딜글 라벨링</title>
<style>
  :root {
    --primary: #FF6600;
    --primary-pressed: #E14D00;
    --primary-contrast: #FFFFFF;
    --primary-weak: #FFF2EC;
    --bg: #FFFFFF;
    --layer: #FFFFFF;
    --fill: #F7F8F9;
    --text: #1A1C20;
    --text-muted: #555D6D;
    --text-subtle: #868B94;
    --placeholder: #B0B3BA;
    --border-weak: #DCDEE3;
    --border-subtle: rgba(0,0,0,0.047);
    --positive: #079171;
    --positive-weak: #EDFAF6;
    --critical: #FA342C;
    --critical-weak: #FDF0F0;
    --warning: #D4AB28;
    --warning-solid: #FBDC65;
    --focus-ring: #5E98FE;
    --overlay: rgba(0,0,0,0.455);
    --inverted-bg: #2A3038;
    --inverted-text: #FFFFFF;
    --shadow-1: 0px 1px 4px 0px rgba(0,0,0,0.078);
    --shadow-3: 0px 4px 16px 0px rgba(0,0,0,0.122);
    --radius-pill: 9999px;
    --ease: cubic-bezier(0.35,0,0.35,1);
    --ease-enter: cubic-bezier(0,0,0.15,1);
    --font: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Segoe UI", Roboto,
      "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji",
      "Segoe UI Symbol", "Noto Color Emoji";
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; background: var(--bg); height: 100%; }
  body {
    font-family: var(--font);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
  }
  button { font-family: inherit; cursor: pointer; }
  input, textarea, select { font-family: inherit; }
  button:active { opacity: 0.85; }
  .hidden { display: none !important; }

  /* ===== Login ===== */
  .login-wrap {
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    padding: 20px;
    background: var(--bg);
  }
  .login-card { width: 100%; max-width: 320px; }
  .login-card h1 { font-size: 22px; line-height: 30px; font-weight: 700; margin: 0 0 28px; }
  .field { margin-bottom: 14px; }
  .field-label { display: block; font-size: 13px; line-height: 18px; font-weight: 700; color: var(--text-subtle); margin-bottom: 6px; }
  .field-input, .field-textarea, .field-select {
    width: 100%; padding: 13px 14px; background: var(--fill); color: var(--text);
    border: 1px solid transparent; border-radius: 12px; font-size: 15px; outline: none;
    transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease);
  }
  .field-input::placeholder, .field-textarea::placeholder { color: var(--placeholder); }
  .field-input:focus, .field-textarea:focus, .field-select:focus {
    border-color: var(--focus-ring); box-shadow: 0 0 0 3px rgba(94,152,254,0.3);
  }
  .field-textarea { resize: vertical; min-height: 64px; }

  .action-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 14px 20px; border: none; border-radius: var(--radius-pill);
    font-size: 15px; line-height: 20px; font-weight: 700;
    transition: background 150ms var(--ease), color 150ms var(--ease), opacity 150ms var(--ease);
  }
  .action-btn.full { width: 100%; }
  .action-btn.primary { background: var(--primary); color: var(--primary-contrast); }
  .action-btn.primary:hover { background: var(--primary-pressed); }
  .action-btn.secondary { background: var(--fill); color: var(--text); }
  .action-btn.critical-weak { background: var(--critical-weak); color: var(--critical); }

  /* ===== App shell (sidebar dashboard layout) ===== */
  .shell { display: flex; min-height: 100vh; align-items: stretch; }

  .sidebar {
    width: 240px; flex-shrink: 0;
    background: var(--layer); border-right: 1px solid var(--border-subtle);
    display: flex; flex-direction: column;
    padding: 24px 14px; position: sticky; top: 0; height: 100vh; overflow-y: auto;
  }
  .sidebar-header { font-size: 17px; font-weight: 700; padding: 0 10px; margin-bottom: 18px; }
  .sidebar-content { display: flex; flex-direction: column; gap: 4px; }
  .sidebar-footer { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--border-subtle); display: flex; flex-direction: column; gap: 10px; }
  .nav-item {
    display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
    padding: 12px 12px; border-radius: 12px; border: none; background: transparent;
    font-size: 14px; line-height: 19px; font-weight: 700; color: var(--text-subtle);
    transition: background 150ms var(--ease), color 150ms var(--ease);
  }
  .nav-item:hover { background: var(--fill); }
  .nav-item.active { background: var(--primary-weak); color: var(--primary); }
  .nav-item .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--primary); opacity: 0; }
  .nav-item.active .dot { opacity: 1; }

  .main { flex: 1; min-width: 0; }

  .pill-tag { font-size: 12px; line-height: 16px; font-weight: 700; padding: 5px 12px; border-radius: var(--radius-pill); background: var(--fill); color: var(--text); display: inline-block; }
  .pill-tag b { color: var(--primary); }
  .link-btn { background: none; border: none; color: var(--text-muted); font-size: 13px; line-height: 18px; font-weight: 700; padding: 0; text-align: left; }
  .link-btn.brand { color: var(--primary); }

  .page-title { font-size: 20px; line-height: 27px; font-weight: 700; margin: 0 0 20px; }
  .page-title .pill-tag { vertical-align: middle; margin-left: 4px; }
  .page-body { padding: 24px 28px 48px; max-width: 1040px; width: 100%; }

  .search-field { position: relative; margin-bottom: 18px; max-width: 360px; }
  .search-field input {
    width: 100%; padding: 12px 14px; background: var(--fill); color: var(--text);
    border: 1px solid transparent; border-radius: 12px; font-size: 14px; outline: none;
    transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease);
  }
  .search-field input::placeholder { color: var(--placeholder); }
  .search-field input:focus { border-color: var(--focus-ring); box-shadow: 0 0 0 3px rgba(94,152,254,0.3); }

  /* ===== Post list (flat rows, no card chrome) ===== */
  .post-grid { display: block; }
  .post-card {
    display: block; width: 100%; text-align: left; cursor: pointer;
    background: transparent; border: none; border-bottom: 1px solid var(--border-subtle);
    padding: 16px 4px; transition: background 150ms var(--ease);
  }
  .post-card:last-child { border-bottom: none; }
  .post-card:hover { background: var(--fill); }
  .post-card .row { display: flex; align-items: center; gap: 12px; }
  .post-card .main-col { flex: 1; min-width: 0; }
  .post-card .title { font-size: 15px; line-height: 20px; font-weight: 700; margin: 0 0 3px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .post-card .desc {
    font-size: 13px; line-height: 18px; color: var(--text-subtle); margin: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .post-card .meta { font-size: 11px; line-height: 15px; color: var(--text-subtle); margin: 4px 0 0; }
  .post-card .id-tag { color: var(--text-subtle); font-weight: 700; margin-right: 4px; }
  .detail-id-tag { color: var(--critical); font-weight: 700; margin-right: 6px; }
  .post-card .suffix { flex-shrink: 0; display: flex; align-items: center; gap: 8px; }
  .post-card .suffix .count { font-size: 12px; color: var(--text-subtle); }
  .badge { font-size: 12px; line-height: 16px; font-weight: 700; padding: 5px 10px; border-radius: var(--radius-pill); white-space: nowrap; }
  .badge.positive { background: var(--positive-weak); color: var(--positive); }
  .badge.critical { background: var(--critical-weak); color: var(--critical); }
  .badge.warning { background: var(--warning-solid); color: #1A1C20; }
  .badge.brand { background: var(--primary); color: var(--primary-contrast); }

  .empty-state { text-align: center; color: var(--text-subtle); padding: 64px 20px; font-size: 14px; line-height: 19px; }

  /* ===== Upload ===== */
  .accordion { background: var(--fill); border-radius: 16px; padding: 14px 16px; margin-bottom: 16px; }
  .accordion summary {
    display: flex; align-items: center; justify-content: space-between;
    font-weight: 700; font-size: 14px; line-height: 19px; cursor: pointer; color: var(--primary); list-style: none;
  }
  .accordion summary::-webkit-details-marker { display: none; }
  .accordion ol { margin: 12px 0 0; padding-left: 20px; font-size: 13px; line-height: 20px; color: var(--text); }
  .accordion li + li { margin-top: 6px; }
  .criteria-edit-btn {
    background: none; border: none; color: var(--text-subtle);
    font-size: 12px; font-weight: 700; padding: 2px 6px;
  }
  .criteria-edit-btn:hover { color: var(--primary); }

  .toolbar { display: inline-flex; width: fit-content; gap: 6px; align-items: center; margin-bottom: 16px; }

  .upload-sticky-header {
    position: sticky; top: 0; z-index: 6;
    background: var(--bg); padding-top: 4px; margin-bottom: 4px;
  }
  .upload-sticky-header .accordion { margin-bottom: 12px; }
  .upload-sticky-header .toolbar { margin-bottom: 12px; }

  #section-upload { padding-bottom: 90px; }
  .add-row-wrap { display: none; }
  .add-row-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 10px 20px;
    border: 1.5px dashed var(--border-weak); border-radius: 12px;
    background: transparent; color: var(--text-subtle);
    font-size: 14px; font-weight: 700;
    transition: border-color 150ms var(--ease), color 150ms var(--ease), background 150ms var(--ease);
  }
  .add-row-btn:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-weak); }
  .add-row-icon { display: none; }

  .add-placeholder {
    display: flex; align-items: center; justify-content: center;
    min-height: 180px;
    border: 1.5px dashed var(--border-weak); border-radius: 14px;
    background: transparent; color: var(--text-subtle);
    font-size: 28px; font-weight: 400;
    transition: border-color 150ms var(--ease), color 150ms var(--ease), background 150ms var(--ease);
  }
  .add-placeholder:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-weak); }

  .upload-submit-fixed {
    position: fixed; right: 28px; bottom: 28px; z-index: 25;
  }

  .upload-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .upload-row { border: 1px solid var(--border-weak); border-radius: 14px; padding: 14px; background: var(--layer); }
  .upload-row-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .upload-row-head input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--primary); }
  .upload-row-head .index { font-size: 13px; line-height: 18px; color: var(--text-subtle); font-weight: 700; }
  .remove-row-btn { margin-left: auto; background: none; border: none; color: var(--critical); font-size: 13px; line-height: 18px; font-weight: 700; }

  .label-toggle { display: flex; gap: 6px; }
  .toggle-btn {
    flex: 1; padding: 9px 4px; border-radius: 10px; border: 1px solid var(--border-weak);
    background: var(--layer); font-size: 12px; font-weight: 700; color: var(--text-subtle);
    transition: background 150ms var(--ease), color 150ms var(--ease), border-color 150ms var(--ease);
  }
  .toggle-btn.active { border-color: transparent; }
  .toggle-btn[data-value=""].active { background: var(--fill); color: var(--text); border-color: var(--border-weak); }
  .toggle-btn[data-value="0"].active { background: var(--positive-weak); color: var(--positive); }
  .toggle-btn[data-value="1"].active { background: var(--critical-weak); color: var(--critical); }
  .toggle-btn[data-value="2"].active { background: var(--warning-solid); color: #1A1C20; }

  /* ===== Side panel (detail) ===== */
  .panel-backdrop {
    position: fixed; inset: 0; background: var(--overlay); z-index: 100;
    opacity: 0; pointer-events: none; transition: opacity 200ms var(--ease);
  }
  .panel-backdrop.open { opacity: 1; pointer-events: auto; }
  .side-panel {
    position: fixed; top: 0; right: 0; height: 100vh;
    width: min(440px, 100vw);
    background: var(--bg); box-shadow: var(--shadow-3);
    display: flex; flex-direction: column;
    transform: translateX(100%);
    transition: transform 250ms var(--ease-enter);
    z-index: 101;
  }
  .panel-backdrop.open .side-panel { transform: translateX(0); }
  .panel-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; flex-shrink: 0; border-bottom: 1px solid var(--border-subtle); }
  .panel-header h3 { font-size: 16px; line-height: 22px; font-weight: 700; margin: 0; }
  .panel-header button { background: none; border: none; font-size: 22px; line-height: 1; color: var(--text-subtle); padding: 4px; }
  .panel-body { padding: 16px 20px; overflow-y: auto; flex: 1; }
  .panel-footer { padding: 14px 20px calc(16px + env(safe-area-inset-bottom)); flex-shrink: 0; border-top: 1px solid var(--border-subtle); }

  .divider { border: none; border-top: 1px solid var(--border-subtle); margin: 16px 0; }

  .pick-row { display: flex; gap: 8px; }
  .pick-row button {
    flex: 1; padding: 13px; border-radius: 12px; border: 1px solid var(--border-weak);
    background: var(--layer); font-size: 14px; line-height: 19px; font-weight: 700; color: var(--text);
    transition: border-color 150ms var(--ease), color 150ms var(--ease);
  }
  .pick-row button[data-label="0"]:hover { border-color: var(--positive); color: var(--positive); }
  .pick-row button[data-label="1"]:hover { border-color: var(--critical); color: var(--critical); }
  .pick-row button[data-label="2"]:hover { border-color: var(--warning); color: var(--warning); }

  .eval-row { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border-subtle); gap: 10px; }
  .eval-row:last-child { border-bottom: none; }
  .eval-row .name { font-size: 14px; line-height: 19px; font-weight: 700; flex-shrink: 0; margin-right: auto; }
  .eval-pick { display: flex; gap: 5px; flex-shrink: 0; }
  .eval-pick button {
    padding: 6px 10px; border: 1px solid var(--border-weak); border-radius: 9px;
    background: var(--layer); font-size: 12px; font-weight: 700; color: var(--text-subtle);
    transition: background 150ms var(--ease), color 150ms var(--ease), border-color 150ms var(--ease);
  }
  .eval-pick button.active-pick { border-color: transparent; }
  .eval-pick button[data-label="0"].active-pick { background: var(--positive-weak); color: var(--positive); }
  .eval-pick button[data-label="1"].active-pick { background: var(--critical-weak); color: var(--critical); }
  .eval-pick button[data-label="2"].active-pick { background: var(--warning-solid); color: #1A1C20; }
  .eval-delete-btn {
    flex-shrink: 0; background: none; border: none; color: var(--text-subtle);
    font-size: 18px; line-height: 1; padding: 2px 4px;
  }
  .eval-delete-btn:hover { color: var(--critical); }

  /* ===== Detail panel comments ===== */
  .detail-comments-list { display: flex; flex-direction: column; }
  .detail-comment-row { display: flex; align-items: flex-start; gap: 10px; padding: 12px 0; }
  .detail-comment-row + .detail-comment-row { border-top: 1px solid var(--border-subtle); }
  .detail-comment-avatar {
    flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%;
    background: var(--primary-weak); color: var(--primary);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
  }
  .detail-comment-body { flex: 1; min-width: 0; }
  .detail-comment-meta { margin: 0; line-height: 18px; }
  .detail-comment-meta .name { font-size: 13px; font-weight: 700; margin-right: 6px; }
  .detail-comment-meta .time { font-size: 11px; color: var(--text-subtle); }
  .detail-comment-text { font-size: 14px; line-height: 1.5; color: var(--text); margin: 3px 0 0; white-space: pre-wrap; word-break: break-word; }
  .detail-comments-empty { text-align: center; color: var(--text-subtle); font-size: 13px; padding: 20px 0; }

  .detail-comment-input-row { display: flex; align-items: center; gap: 4px; margin-top: 12px; }
  .detail-comment-input-row input {
    flex: 1; padding: 10px 14px; border-radius: var(--radius-pill); border: 1px solid transparent;
    background: var(--fill); color: var(--text); font-size: 13px; outline: none;
    transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease);
  }
  .detail-comment-input-row input::placeholder { color: var(--placeholder); }
  .detail-comment-input-row input:focus { border-color: var(--focus-ring); box-shadow: 0 0 0 3px rgba(94,152,254,0.3); }
  .detail-comment-submit-btn {
    flex-shrink: 0; background: none; border: none; color: var(--primary);
    font-size: 13px; font-weight: 700; padding: 8px 10px;
  }

  /* ===== Dialog (export data) ===== */
  .modal-backdrop {
    position: fixed; inset: 0; background: var(--overlay); z-index: 160;
    display: flex; align-items: center; justify-content: center; padding: 20px;
    opacity: 0; pointer-events: none; transition: opacity 200ms var(--ease);
  }
  .modal-backdrop.open { opacity: 1; pointer-events: auto; }
  .modal {
    width: 100%; max-width: 560px; max-height: 80vh;
    background: var(--layer); border-radius: 20px; box-shadow: var(--shadow-3);
    display: flex; flex-direction: column;
    transform: scale(0.96); transition: transform 200ms var(--ease-enter);
  }
  .modal-backdrop.open .modal { transform: scale(1); }
  .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; flex-shrink: 0; border-bottom: 1px solid var(--border-subtle); }
  .modal-header h3 { font-size: 16px; line-height: 22px; font-weight: 700; margin: 0; }
  .modal-header button { background: none; border: none; font-size: 22px; line-height: 1; color: var(--text-subtle); padding: 4px; }
  .modal-body { padding: 16px 20px; overflow-y: auto; flex: 1; }
  .modal-body textarea {
    width: 100%; height: 320px; resize: vertical;
    background: var(--fill); color: var(--text); border: 1px solid var(--border-weak);
    border-radius: 12px; padding: 12px; font-size: 13px; line-height: 18px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .modal-footer { padding: 14px 20px calc(16px + env(safe-area-inset-bottom)); flex-shrink: 0; border-top: 1px solid var(--border-subtle); }

  /* ===== Shorts evaluation ===== */
  .shorts-overlay {
    position: fixed; inset: 0; background: #000; z-index: 150;
    display: flex; align-items: stretch; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 200ms var(--ease);
  }
  .shorts-overlay.open { opacity: 1; pointer-events: auto; }
  .shorts-card-wrap { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--bg); }
  .shorts-close-btn {
    position: absolute; top: 14px; right: 14px; z-index: 10;
    background: rgba(0,0,0,0.35); border: none; color: #fff;
    width: 36px; height: 36px; border-radius: 50%; font-size: 20px; line-height: 1;
  }
  .shorts-nav-btn { display: none; }
  .shorts-stage { position: relative; width: 100%; height: 100%; touch-action: none; overflow: hidden; }
  .shorts-card {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    padding: 64px 20px 28px; overflow-y: auto; will-change: transform, opacity;
  }
  .shorts-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-shrink: 0; }
  .shorts-criteria-wrap { position: relative; }
  .shorts-criteria-btn { background: var(--fill); border-radius: var(--radius-pill); padding: 5px 12px; }
  .shorts-card-body { flex: 1 0 auto; padding-right: 52px; }
  .shorts-title { font-size: 18px; font-weight: 700; line-height: 25px; margin: 0 0 10px; }
  .shorts-content { font-size: 15px; line-height: 1.6; color: var(--text-muted); white-space: pre-wrap; margin: 0; }
  .shorts-source-btn { margin-top: 10px; }
  .shorts-actions {
    position: absolute; right: 14px; bottom: 90px; display: flex; flex-direction: column;
    align-items: center; gap: 22px; z-index: 5;
  }
  .shorts-heart-btn, .shorts-comment-btn { display: flex; flex-direction: column; align-items: center; gap: 2px; background: none; border: none; color: #fff; }
  .shorts-heart-icon { display: inline-block; font-size: 34px; line-height: 1; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,0.4); transition: transform 150ms var(--ease); }
  .shorts-heart-btn.active .shorts-heart-icon { transform: scale(1.2); }
  .shorts-heart-btn[data-label="0"] .shorts-heart-icon { color: var(--positive); }
  .shorts-heart-btn[data-label="1"] .shorts-heart-icon { color: var(--critical); }
  .shorts-heart-btn[data-label="2"] .shorts-heart-icon { color: var(--warning); }
  .shorts-comment-icon { width: 27px; height: 27px; display: block; filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4)); }
  .shorts-comment-count { font-size: 12px; font-weight: 700; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,0.4); }

  /* ===== Criteria popover (speech-bubble style, anchored to the trigger) ===== */
  .shorts-criteria-popover {
    position: absolute; top: calc(100% + 10px); right: 0;
    width: 240px; max-width: calc(100vw - 48px);
    background: var(--layer); color: var(--text); border-radius: 14px;
    box-shadow: var(--shadow-3); padding: 14px 16px; z-index: 12;
    opacity: 0; transform: scale(0.94) translateY(-6px); transform-origin: top right;
    pointer-events: none;
    transition: opacity 160ms var(--ease-enter), transform 160ms var(--ease-enter);
  }
  .shorts-criteria-popover.open { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; }
  .shorts-criteria-popover-arrow {
    position: absolute; top: -5px; right: 22px; width: 10px; height: 10px;
    background: var(--layer); transform: rotate(45deg);
  }
  .shorts-criteria-popover-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .shorts-criteria-popover-head span { font-size: 13px; font-weight: 700; }
  .shorts-criteria-popover-list { margin: 0; padding-left: 18px; font-size: 12px; line-height: 1.6; color: var(--text-muted); max-height: 40vh; overflow-y: auto; }
  .shorts-criteria-popover-list li + li { margin-top: 4px; }
  .shorts-label-toast {
    position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%) scale(0.9);
    background: var(--inverted-bg); color: var(--inverted-text); font-size: 15px; font-weight: 700;
    padding: 10px 18px; border-radius: var(--radius-pill); opacity: 0; pointer-events: none;
    transition: opacity 200ms var(--ease), transform 200ms var(--ease); z-index: 6;
  }
  .shorts-label-toast.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }

  .shorts-comments-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.3); z-index: 19; opacity: 0; transition: opacity 200ms var(--ease); }
  .shorts-comments-backdrop.open { opacity: 1; }
  .shorts-comments-sheet {
    position: absolute; left: 0; right: 0; bottom: 0; height: 62%;
    background: var(--layer); border-radius: 20px 20px 0 0; box-shadow: var(--shadow-3);
    display: flex; flex-direction: column; transform: translateY(100%);
    transition: transform 220ms var(--ease-enter); z-index: 20;
  }
  .shorts-comments-sheet.open { transform: translateY(0); }
  .shorts-comments-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--border-subtle); flex-shrink: 0; }
  .shorts-comments-header h3 { margin: 0; font-size: 15px; font-weight: 700; }
  .shorts-comments-header button { background: none; border: none; font-size: 20px; color: var(--text-subtle); padding: 2px 4px; }
  .shorts-comments-list { flex: 1; overflow-y: auto; padding: 8px 18px; }
  .shorts-comment-row { display: flex; align-items: flex-start; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--border-subtle); }
  .shorts-comment-row:last-child { border-bottom: none; }
  .shorts-comment-body { flex: 1; min-width: 0; }
  .shorts-comment-row .name { font-size: 13px; font-weight: 700; margin-right: 6px; }
  .shorts-comment-row .time { font-size: 11px; color: var(--text-subtle); }
  .shorts-comment-row .text { font-size: 13px; line-height: 18px; margin: 4px 0 0; }
  .comment-delete-btn {
    flex-shrink: 0; background: none; border: none; color: var(--critical);
    font-size: 15px; line-height: 1; padding: 2px 4px;
  }
  .shorts-comments-empty { text-align: center; color: var(--text-subtle); font-size: 13px; padding: 32px 0; }
  .shorts-comments-input-row { display: flex; gap: 8px; padding: 12px 18px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--border-subtle); flex-shrink: 0; }
  .shorts-comments-input-row input {
    flex: 1; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--border-weak);
    background: var(--fill); color: var(--text); font-size: 13px; outline: none;
  }

  @media (min-width: 768px) {
    .shorts-overlay { align-items: center; background: var(--overlay); }
    .shorts-card-wrap { width: 400px; height: 86vh; max-height: 800px; border-radius: 28px; box-shadow: var(--shadow-3); }
    .shorts-nav-btn {
      display: flex; align-items: center; justify-content: center;
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
      width: 32px; height: 56px; border: none; background: none;
      color: var(--text-subtle); font-size: 26px; font-weight: 700;
      transition: color 150ms var(--ease);
    }
    .shorts-nav-btn:hover { color: var(--primary); }
    .shorts-nav-btn.prev { left: 2px; }
    .shorts-nav-btn.next { right: 2px; }
  }

  /* ===== Snackbar ===== */
  .snackbar {
    position: fixed; bottom: calc(24px + env(safe-area-inset-bottom)); left: 50%;
    transform: translateX(-50%) translateY(8px);
    display: flex; align-items: center; gap: 8px;
    background: var(--inverted-bg); color: var(--inverted-text);
    padding: 12px 18px; border-radius: var(--radius-pill);
    font-size: 14px; line-height: 19px; font-weight: 600; box-shadow: var(--shadow-3);
    z-index: 200; opacity: 0; pointer-events: none;
    transition: opacity 200ms var(--ease), transform 200ms var(--ease);
    max-width: 90vw;
  }
  .snackbar.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* ===== Hamburger menu (mobile only) ===== */
  .hamburger-btn { display: none; }

  /* ===== Responsive: bottom tab bar + top-right menu under md ===== */
  @media (max-width: 767px) {
    .shell { flex-direction: column; }
    .sidebar {
      position: fixed; top: auto;
      bottom: calc(28px + env(safe-area-inset-bottom)); left: 14px; right: 14px;
      width: auto; height: auto;
      flex-direction: row; align-items: stretch;
      border: none; border-radius: var(--radius-pill);
      box-shadow: var(--shadow-3);
      padding: 6px; z-index: 20;
    }
    .sidebar-header { display: none; }
    .sidebar-content { flex-direction: row; width: 100%; gap: 0; }
    .nav-item {
      flex: 1; flex-direction: column; gap: 3px; white-space: normal;
      padding: 10px 4px; font-size: 11px; border-radius: var(--radius-pill);
    }

    .hamburger-btn {
      display: flex; align-items: center; justify-content: center;
      position: fixed; top: 16px; right: 16px; z-index: 30;
      background: none; border: none; font-size: 26px; color: var(--text);
      padding: 4px;
    }
    .sidebar-footer {
      display: none; position: fixed; top: 60px; right: 14px; z-index: 30;
      width: 220px; background: var(--layer); border: 1px solid var(--border-weak);
      border-radius: 14px; box-shadow: var(--shadow-3); padding: 14px;
      margin-top: 0; padding-top: 14px; border-top: 1px solid var(--border-weak);
      flex-direction: column; gap: 10px;
    }
    .sidebar-footer.open { display: flex; }

    .page-body { padding: 16px 16px calc(120px + env(safe-area-inset-bottom)); }
    .side-panel { width: 100vw; }

    .add-row-wrap { display: flex; justify-content: flex-end; margin-bottom: 16px; }
    .add-row-full { display: none; }
    .add-row-icon { display: inline; }
    .add-row-btn {
      width: 44px; height: 44px; padding: 0; border-radius: 50%;
      font-size: 22px; line-height: 1;
    }
    .add-placeholder { display: none; }

    .upload-submit-fixed {
      left: 14px; right: 14px; bottom: calc(96px + env(safe-area-inset-bottom));
    }
    .upload-submit-btn { width: 100%; }
  }
</style>
</head>
<body>

<div id="view-login" class="login-wrap">
  <div class="login-card">
    <h1>핫딜글 라벨링</h1>
    <div class="field">
      <input id="loginName" class="field-input" type="text" placeholder="이름을 입력하세요" maxlength="20">
    </div>
    <div class="field">
      <input id="loginPin" class="field-input" type="password" inputmode="numeric" maxlength="4" placeholder="비밀번호 (숫자 4자리)">
    </div>
    <button class="action-btn primary full" onclick="App.login()">입장하기</button>
  </div>
</div>

<div id="view-app" class="hidden shell">
  <button id="menuToggle" class="hamburger-btn" onclick="App.toggleMobileMenu()">☰</button>

  <nav class="sidebar">
    <p class="sidebar-header">핫딜글 라벨링</p>
    <div class="sidebar-content">
      <button class="nav-item active" data-tab="PENDING" onclick="App.switchTab('PENDING')"></span>평가 진행중</button>
      <button class="nav-item" data-tab="COMPLETED" onclick="App.switchTab('COMPLETED')"></span>평가 완료</button>
      <button class="nav-item" data-tab="UPLOAD" onclick="App.switchTab('UPLOAD')"></span>업로드</button>
    </div>
    <div class="sidebar-footer">
      <button class="link-btn brand" onclick="App.copyTrainingData()">학습 데이터</button>
      <button class="link-btn brand" onclick="App.openShorts()">평가시작</button>
      <button class="link-btn" onclick="App.logout()">로그아웃</button>
    </div>
  </nav>

  <main class="main">
    <div class="page-body">
      <h2 id="sectionTitle" class="page-title"><span id="sectionTitleText">평가 진행중</span> <span id="sectionCount" class="pill-tag"><b>0</b>건</span></h2>
      <div id="section-list">
        <div class="search-field">
          <input id="searchInput" type="text" placeholder="검색" oninput="App.onSearch()">
        </div>
        <div id="labelFilter" class="label-toggle hidden" style="width:auto;margin-bottom:16px;" onclick="App.selectLabelFilter(event)">
          <button type="button" class="toggle-btn active" data-value="">전체</button>
          <button type="button" class="toggle-btn" data-value="0">정상글</button>
          <button type="button" class="toggle-btn" data-value="1">광고글</button>
          <button type="button" class="toggle-btn" data-value="2">애매함</button>
        </div>
        <div id="postGrid" class="post-grid"></div>
      </div>

      <div id="section-upload" class="hidden">
        <div class="upload-sticky-header">
          <details class="accordion">
            <summary>
              <span>평가 기준</span>
              <button type="button" class="criteria-edit-btn" onclick="event.preventDefault(); event.stopPropagation(); App.openCriteriaEditor();">수정</button>
            </summary>
            <ol id="criteriaListUpload"></ol>
          </details>

          <div class="toolbar">
            <input type="checkbox" id="selectAllRowsCheck" style="width:18px;height:18px;accent-color:var(--primary);" onchange="App.toggleSelectAllRows(event)">
            <select id="bulkLabelSelect" class="field-select" style="width:auto;padding:6px 8px;font-size:13px;">
              <option value="">선택</option>
              <option value="0">정상</option>
              <option value="1">광고</option>
              <option value="2">애매</option>
            </select>
            <button class="action-btn primary" style="padding:6px 12px;font-size:13px;" onclick="App.applyBulkLabel()">일괄적용</button>
          </div>
        </div>

        <div id="uploadRows" class="upload-grid"></div>

        <div class="add-row-wrap">
          <button class="add-row-btn" onclick="App.addUploadRow()">
            <span class="add-row-full">+ 항목 추가</span>
            <span class="add-row-icon">+</span>
          </button>
        </div>
      </div>
    </div>

    <div class="upload-submit-fixed hidden" id="uploadSubmitFixed">
      <button class="action-btn primary upload-submit-btn" onclick="App.submitUpload()">업로드하기</button>
    </div>
  </main>
</div>

<div id="detailOverlay" class="panel-backdrop hidden" onmousedown="App.onBackdropMouseDown(event)" onclick="App.onOverlayClick(event)">
  <div class="side-panel">
    <div class="panel-header">
      <h3>평가글 상세</h3>
      <button onclick="App.closeDetail()">&times;</button>
    </div>
    <div id="detailBody" class="panel-body"></div>
    <div id="detailFooter" class="panel-footer"></div>
  </div>
</div>

<div id="exportDialog" class="modal-backdrop hidden" onmousedown="App.onBackdropMouseDown(event)" onclick="App.onExportBackdropClick(event)">
  <div class="modal">
    <div class="modal-header">
      <h3>학습 데이터</h3>
      <button onclick="App.closeExportDialog()">&times;</button>
    </div>
    <div class="modal-body">
      <textarea id="exportText" readonly></textarea>
    </div>
    <div class="modal-footer">
      <button class="action-btn primary full" onclick="App.copyExportText()">복사하기</button>
    </div>
  </div>
</div>

<div id="criteriaDialog" class="modal-backdrop hidden" onmousedown="App.onBackdropMouseDown(event)" onclick="App.onCriteriaBackdropClick(event)">
  <div class="modal">
    <div class="modal-header">
      <h3>평 기준 수정</h3>
      <button onclick="App.closeCriteriaEditor()">&times;</button>
    </div>
    <div class="modal-body">
      <textarea id="criteriaText" placeholder="한 줄에 하나씩 작성하세요"></textarea>
    </div>
    <div class="modal-footer">
      <button class="action-btn primary full" onclick="App.saveCriteria()">저장</button>
    </div>
  </div>
</div>

<div id="shortsOverlay" class="shorts-overlay hidden" onmousedown="App.onBackdropMouseDown(event)" onclick="App.onShortsBackdropClick(event)">
  <div class="shorts-card-wrap">
    <button class="shorts-close-btn" onclick="App.closeShorts()">&times;</button>
    <button class="shorts-nav-btn prev" onclick="App.shortsCommit('down')">&#8249;</button>
    <button class="shorts-nav-btn next" onclick="App.shortsCommit('up')">&#8250;</button>
    <div id="shortsStage" class="shorts-stage">
      <div id="shortsCard" class="shorts-card">
        <div class="shorts-card-header">
          <span id="shortsProgress" class="badge brand">평가 0/3</span>
          <div class="shorts-criteria-wrap">
            <button type="button" id="shortsCriteriaBtn" class="criteria-edit-btn shorts-criteria-btn" onclick="App.toggleShortsCriteria(event)">평가기준</button>
            <div id="shortsCriteriaPopover" class="shorts-criteria-popover hidden">
              <div class="shorts-criteria-popover-arrow"></div>
              <div class="shorts-criteria-popover-head">
                <span>평가 기준</span>
                <button type="button" class="criteria-edit-btn" onclick="App.openCriteriaEditor()">수정</button>
              </div>
              <ol id="shortsCriteriaPopoverList" class="shorts-criteria-popover-list"></ol>
            </div>
          </div>
        </div>
        <div class="shorts-card-body">
          <p id="shortsTitle" class="shorts-title"></p>
          <p id="shortsContent" class="shorts-content"></p>
          <button type="button" id="shortsSourceBtn" class="link-btn brand shorts-source-btn hidden" onclick="App.openSourceUrl(this)">원본글 보기 ↗</button>
        </div>
        <div class="shorts-actions">
          <button type="button" id="shortsHeartBtn" class="shorts-heart-btn" onclick="App.toggleShortsHeart()">
            <span class="shorts-heart-icon">♡</span>
          </button>
          <button type="button" id="shortsCommentBtn" class="shorts-comment-btn" onclick="App.openShortsComments()">
            <svg class="shorts-comment-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 4C7.4 4 2 8.56 2 14.2c0 3.1 1.66 5.87 4.28 7.74-.1 1.24-.5 2.76-1.28 4.26 1.98-.4 3.76-1.24 5.12-2.14 1.2.34 2.5.54 3.88.54 6.6 0 12-4.56 12-10.2S20.6 4 14 4z" fill="#fff"/>
            </svg>
            <span id="shortsCommentCount" class="shorts-comment-count">0</span>
          </button>
        </div>
        <div id="shortsLabelToast" class="shorts-label-toast"></div>
      </div>
    </div>
    <div id="shortsCommentsBackdrop" class="shorts-comments-backdrop hidden" onclick="App.closeShortsComments()"></div>
    <div id="shortsCommentsSheet" class="shorts-comments-sheet hidden">
      <div class="shorts-comments-header">
        <h3>댓글</h3>
        <button onclick="App.closeShortsComments()">&times;</button>
      </div>
      <div id="shortsCommentsList" class="shorts-comments-list"></div>
      <div class="shorts-comments-input-row">
        <input id="shortsCommentInput" type="text" placeholder="댓글을 입력하세요" maxlength="300" onkeydown="if(event.key==='Enter'){event.preventDefault();App.submitShortsComment();}">
        <button class="action-btn primary" onclick="App.submitShortsComment()">등록</button>
      </div>
    </div>
  </div>
</div>

<div id="toast" class="snackbar"><span>✓</span><span id="toastText"></span></div>

<script>
const App = (function () {

  let currentTab = 'PENDING';
  let currentEvaluator = null;
  let currentDetailId = null;
  let backdropMouseDownOnSelf = false;

  function onBackdropMouseDown(event) {
    backdropMouseDownOnSelf = (event.target === event.currentTarget);
  }
  let uploadRowSeq = 0;

  let shortsQueue = [];
  let shortsIndex = -1;
  let shortsDragging = false;
  let shortsDragStartY = 0;
  let shortsLastDy = 0;
  let shortsCommentsPostId = null;
  let shortsLabelToastTimer = null;

  const TAB_TITLES = { PENDING: '진행중', COMPLETED: '완료', UPLOAD: '업로드' };

  function toast(message) {
    document.getElementById('toastText').textContent = message;
    const el = document.getElementById('toast');
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 1800);
  }

  async function api(url, options) {
    const res = await fetch(url, Object.assign({
      headers: { 'Content-Type': 'application/json' }
    }, options));
    return res.json();
  }

  function labelBadge(label) {
    if (label === 0) return '<span class="badge positive">정상</span>';
    if (label === 1) return '<span class="badge critical">광고</span>';
    if (label === 2) return '<span class="badge warning">애매</span>';
    return '';
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str == null ? '' : str;
    return div.innerHTML;
  }

  async function login() {
    const name = document.getElementById('loginName').value.trim();
    const pin = document.getElementById('loginPin').value.trim();
    if (!name || !/^[0-9]{4}$/.test(pin)) {
      toast('이름과 숫자 4자리를 입력해주세요.');
      return;
    }
    const ok = await attemptLogin(name, pin);
    if (ok) {
      localStorage.setItem('evaluatorName', name);
      localStorage.setItem('evaluatorPin', pin);
    }
  }

  async function attemptLogin(name, pin) {
    const json = await api('/training/api/login', { method: 'POST', body: JSON.stringify({ name, pin }) });
    if (!json.data) {
      toast(json.message || '로그인에 실패했습니다.');
      return false;
    }
    currentEvaluator = json.data;
    enterApp();
    return true;
  }

  async function checkSession() {
    const json = await api('/training/api/me');
    if (json.data) {
      currentEvaluator = json.data;
      enterApp();
      return;
    }

    const savedName = localStorage.getItem('evaluatorName');
    const savedPin = localStorage.getItem('evaluatorPin');
    if (savedName && savedPin) {
      const ok = await attemptLogin(savedName, savedPin);
      if (!ok) {
        localStorage.removeItem('evaluatorName');
        localStorage.removeItem('evaluatorPin');
      }
    }
  }

  async function enterApp() {
    document.getElementById('view-login').classList.add('hidden');
    document.getElementById('view-app').classList.remove('hidden');
    await loadCriteria();
    document.getElementById('criteriaListUpload').innerHTML = renderCriteriaItems();
    switchTab('PENDING');
  }

  function toggleMobileMenu() {
    document.querySelector('.sidebar-footer').classList.toggle('open');
  }

  function closeMobileMenu() {
    document.querySelector('.sidebar-footer').classList.remove('open');
  }

  async function logout() {
    closeMobileMenu();
    await api('/training/api/logout', { method: 'POST' });
    localStorage.removeItem('evaluatorName');
    localStorage.removeItem('evaluatorPin');
    currentEvaluator = null;
    document.getElementById('view-app').classList.add('hidden');
    document.getElementById('view-login').classList.remove('hidden');
  }

  function switchTab(tab) {
    currentTab = tab;
    document.querySelectorAll('.nav-item').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === tab);
    });
    document.getElementById('sectionTitleText').textContent = TAB_TITLES[tab];
    document.getElementById('sectionCount').classList.toggle('hidden', tab === 'UPLOAD');
    document.getElementById('section-list').classList.toggle('hidden', tab === 'UPLOAD');
    document.getElementById('section-upload').classList.toggle('hidden', tab !== 'UPLOAD');
    document.getElementById('uploadSubmitFixed').classList.toggle('hidden', tab !== 'UPLOAD');
    document.getElementById('labelFilter').classList.toggle('hidden', tab !== 'COMPLETED');

    if (tab === 'UPLOAD') {
      if (document.getElementById('uploadRows').children.length === 0) {
        addUploadRow();
      }
    } else {
      loadPosts();
    }
  }

  let searchTimer = null;
  function onSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(loadPosts, 250);
  }

  let labelFilterValue = '';
  function selectLabelFilter(event) {
    const btn = event.target.closest('.toggle-btn');
    if (!btn) return;
    btn.parentElement.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    labelFilterValue = btn.dataset.value;
    loadPosts();
  }

  async function loadPosts() {
    const keyword = document.getElementById('searchInput').value.trim();
    const json = await api('/training/api/posts?status=' + currentTab + '&keyword=' + encodeURIComponent(keyword));
    let posts = json.data || [];
    document.querySelector('#sectionCount b').textContent = posts.length;
    if (currentTab === 'COMPLETED' && labelFilterValue !== '') {
      posts = posts.filter(p => String(p.finalLabel) === labelFilterValue);
    }
    renderPostList(posts);
  }

  function renderPostList(posts) {
    const container = document.getElementById('postGrid');
    if (posts.length === 0) {
      container.innerHTML = '<div class="empty-state">평가글이 없습니다.</div>';
      return;
    }
    container.innerHTML = posts.map(renderPostCard).join('');
  }

  function renderPostCard(post) {
    const evaluatedCount = (post.evaluatorNames || []).length;
    const rightBadge = post.status === 'COMPLETED'
      ? labelBadge(post.finalLabel)
      : '<span class="badge brand">평가 ' + evaluatedCount + '/3</span>';
    return '' +
      '<button class="post-card" onclick="App.openDetail(' + post.id + ')">' +
        '<div class="row">' +
          '<div class="main-col">' +
            '<p class="title"><span class="id-tag">#' + post.id + '</span>' + escapeHtml(post.title) + '</p>' +
            '<p class="desc">' + escapeHtml(post.content) + '</p>' +
            '<p class="meta">' + escapeHtml(formatDateTime(post.createdAt)) + '</p>' +
          '</div>' +
          '<div class="suffix">' +
            rightBadge +
          '</div>' +
        '</div>' +
      '</button>';
  }

  function formatDateTime(value) {
    if (!value) return '';
    let y, mo, d, h, mi;
    if (Array.isArray(value)) {
      [y, mo, d, h, mi] = value;
    } else {
      const date = new Date(value);
      if (isNaN(date.getTime())) return '';
      y = date.getFullYear(); mo = date.getMonth() + 1; d = date.getDate();
      h = date.getHours(); mi = date.getMinutes();
    }
    const pad = n => String(n).padStart(2, '0');
    return y + '.' + pad(mo) + '.' + pad(d) + ' ' + pad(h) + ':' + pad(mi);
  }

  function addUploadRow() {
    uploadRowSeq++;
    const id = uploadRowSeq;
    const wrap = document.createElement('div');
    wrap.className = 'upload-row';
    wrap.dataset.rowId = id;
    wrap.innerHTML = '' +
      '<div class="upload-row-head">' +
        '<input type="checkbox" class="row-check">' +
        '<span class="index">항목 #' + id + '</span>' +
        '<button class="remove-row-btn" onclick="this.closest(\'.upload-row\').remove()">삭제</button>' +
      '</div>' +
      '<div class="field" style="margin-bottom:8px;"><input type="text" class="row-source-url field-input" placeholder="원본 링크 (URL)"></div>' +
      '<div class="field" style="margin-bottom:8px;"><input type="text" class="row-title field-input" placeholder="제목"></div>' +
      '<div class="field" style="margin-bottom:10px;"><textarea class="row-content field-textarea" placeholder="핫딜글 내용"></textarea></div>' +
      '<div class="label-toggle" onclick="App.selectRowLabel(event)">' +
        '<button type="button" class="toggle-btn active" data-value="">미평가</button>' +
        '<button type="button" class="toggle-btn" data-value="0">정상</button>' +
        '<button type="button" class="toggle-btn" data-value="1">광고</button>' +
