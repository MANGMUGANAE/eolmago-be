      '</div>';
    document.getElementById('uploadRows').appendChild(wrap);
    ensureAddPlaceholder();
  }

  function ensureAddPlaceholder() {
    const container = document.getElementById('uploadRows');
    let placeholder = document.getElementById('addRowPlaceholder');
    if (!placeholder) {
      placeholder = document.createElement('button');
      placeholder.id = 'addRowPlaceholder';
      placeholder.type = 'button';
      placeholder.className = 'add-placeholder';
      placeholder.innerHTML = '+';
      placeholder.onclick = addUploadRow;
    }
    container.appendChild(placeholder);
  }

  function selectRowLabel(event) {
    const btn = event.target.closest('.toggle-btn');
    if (!btn) return;
    btn.parentElement.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  function setRowLabel(row, value) {
    const group = row.querySelector('.label-toggle');
    group.querySelectorAll('.toggle-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.value === value);
    });
  }

  function toggleSelectAllRows(event) {
    const checked = event.target.checked;
    document.querySelectorAll('.row-check').forEach(cb => { cb.checked = checked; });
  }

  function applyBulkLabel() {
    const value = document.getElementById('bulkLabelSelect').value;
    if (value === '') { toast('적용할 라벨을 선택해주세요.'); return; }
    document.querySelectorAll('.upload-row').forEach(row => {
      const checked = row.querySelector('.row-check').checked;
      if (checked) {
        setRowLabel(row, value);
      }
    });
  }

  async function submitUpload() {
    const rows = document.querySelectorAll('.upload-row');
    const items = [];
    rows.forEach(row => {
      const title = row.querySelector('.row-title').value.trim();
      const content = row.querySelector('.row-content').value.trim();
      const sourceUrl = row.querySelector('.row-source-url').value.trim();
      const labelValue = row.querySelector('.toggle-btn.active').dataset.value;
      if (!title && !content) return;
      items.push({
        title: title,
        content: content,
        label: labelValue === '' ? null : parseInt(labelValue, 10),
        sourceUrl: sourceUrl
      });
    });
    if (items.length === 0) {
      toast('등록할 내용을 입력해주세요.');
      return;
    }
    const json = await api('/training/api/posts', { method: 'POST', body: JSON.stringify({ items }) });
    const results = json.data || [];
    const failCount = results.filter(r => !r.success).length;
    toast('업로드 완료 (성공 ' + (results.length - failCount) + ', 실패(중복) ' + failCount + ')');
    document.getElementById('uploadRows').innerHTML = '';
    addUploadRow();
    switchTab('PENDING');
  }

