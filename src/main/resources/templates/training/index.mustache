    document.getElementById('shortsCommentsSheet').classList.remove('hidden');
    requestAnimationFrame(() => {
      document.getElementById('shortsCommentsBackdrop').classList.add('open');
      document.getElementById('shortsCommentsSheet').classList.add('open');
    });
    const json = await api('/training/api/posts/' + item.id + '/comments');
    renderShortsComments(json.data || []);
  }

  function closeShortsComments() {
    document.getElementById('shortsCommentsBackdrop').classList.remove('open');
    document.getElementById('shortsCommentsSheet').classList.remove('open');
    setTimeout(() => {
      document.getElementById('shortsCommentsBackdrop').classList.add('hidden');
      document.getElementById('shortsCommentsSheet').classList.add('hidden');
    }, 200);
  }

  function shortsCommentRowHtml(c) {
    return '' +
      '<div class="shorts-comment-row" data-comment-id="' + c.id + '">' +
        '<div class="shorts-comment-body">' +
          '<span class="name">' + escapeHtml(c.evaluatorName) + '</span>' +
          '<span class="time">' + escapeHtml(formatDateTime(c.createdAt)) + '</span>' +
          '<p class="text">' + escapeHtml(c.content) + '</p>' +
        '</div>' +
        '<button type="button" class="comment-delete-btn" onclick="App.deleteShortsComment(' + c.id + ')">&times;</button>' +
      '</div>';
  }

  function renderShortsComments(comments) {
    const list = document.getElementById('shortsCommentsList');
    if (comments.length === 0) {
      list.innerHTML = '<div class="shorts-comments-empty">아직 댓글이 없습니다.</div>';
      return;
    }
    list.innerHTML = comments.map(shortsCommentRowHtml).join('');
    list.scrollTop = list.scrollHeight;
  }

  function appendShortsComment(comment) {
    const list = document.getElementById('shortsCommentsList');
    const empty = list.querySelector('.shorts-comments-empty');
    if (empty) empty.remove();
    list.insertAdjacentHTML('beforeend', shortsCommentRowHtml(comment));
    list.scrollTop = list.scrollHeight;
  }

  async function deleteShortsComment(commentId) {
    await api('/training/api/comments/' + commentId, { method: 'DELETE' });
    const list = document.getElementById('shortsCommentsList');
    const row = list.querySelector('[data-comment-id="' + commentId + '"]');
    if (row) row.remove();

    const item = currentShortsItem();
    if (item) {
      item.commentCount = Math.max(0, (item.commentCount || 0) - 1);
      document.getElementById('shortsCommentCount').textContent = item.commentCount;
    }
    if (!list.querySelector('.shorts-comment-row')) {
      list.innerHTML = '<div class="shorts-comments-empty">아직 댓글이 없습니다.</div>';
    }
  }

  async function submitShortsComment() {
    const input = document.getElementById('shortsCommentInput');
    const content = input.value.trim();
    if (!content || shortsCommentsPostId == null) return;
    const json = await api('/training/api/posts/' + shortsCommentsPostId + '/comments', {
      method: 'POST', body: JSON.stringify({ content })
    });
    input.value = '';
    appendShortsComment(json.data);

    const item = currentShortsItem();
    if (item && item.id === shortsCommentsPostId) {
      item.commentCount = (item.commentCount || 0) + 1;
      document.getElementById('shortsCommentCount').textContent = item.commentCount;
    }
  }

  async function shortsAdvance() {
    if (shortsIndex + 1 < shortsQueue.length) {
      shortsIndex++;
      renderShortsCard(shortsQueue[shortsIndex]);
      return;
    }
    const json = await api('/training/api/evaluation-queue');
    shortsQueue = json.data || [];
    shortsIndex = 0;
    if (shortsQueue.length === 0) {
      toast('평가할 글이 없습니다.');
      closeShorts();
      return;
    }
    renderShortsCard(shortsQueue[shortsIndex]);
  }

  function shortsBack() {
    if (shortsIndex > 0) {
      shortsIndex--;
    }
    renderShortsCard(shortsQueue[shortsIndex]);
  }

  function shortsCommit(direction) {
    if (document.getElementById('shortsCommentsSheet').classList.contains('open')) return;
    const card = document.getElementById('shortsCard');
    const axis = shortsAxisProp();
    card.style.transition = 'transform 260ms ease, opacity 260ms ease';
    card.style.transform = axis + (direction === 'up' ? '(-100%)' : '(100%)');
    card.style.opacity = '0';
    setTimeout(async () => {
      if (direction === 'up') {
        await shortsAdvance();
      } else {
        shortsBack();
      }
      card.style.transition = 'none';
      card.style.transform = axis + (direction === 'up' ? '(100%)' : '(-100%)');
      requestAnimationFrame(() => {
        card.style.transition = 'transform 260ms ease, opacity 260ms ease';
        card.style.transform = axis + '(0)';
        card.style.opacity = '1';
      });
    }, 260);
  }

  function bindShortsDrag() {
    const stage = document.getElementById('shortsStage');
    if (stage.dataset.bound) return;
    stage.dataset.bound = '1';
    stage.addEventListener('touchstart', onShortsTouchStart, { passive: true });
    stage.addEventListener('touchmove', onShortsTouchMove, { passive: false });
    stage.addEventListener('touchend', onShortsTouchEnd);
  }

  function onShortsTouchStart(event) {
    if (event.target.closest('.shorts-heart-btn, .shorts-comment-btn, .shorts-close-btn, .shorts-source-btn, .shorts-comments-sheet')) {
      shortsDragging = false;
      return;
    }
    shortsDragging = true;
    shortsDragStartY = shortsAxisPoint(event.touches[0]);
    shortsLastDy = 0;
    document.getElementById('shortsCard').style.transition = 'none';
  }

  function onShortsTouchMove(event) {
    if (!shortsDragging) return;
    event.preventDefault();
    shortsLastDy = shortsAxisPoint(event.touches[0]) - shortsDragStartY;
    document.getElementById('shortsCard').style.transform = shortsAxisProp() + '(' + shortsLastDy + 'px)';
  }

  function onShortsTouchEnd() {
    if (!shortsDragging) return;
    shortsDragging = false;
    const card = document.getElementById('shortsCard');
    const threshold = (shortsIsDesktop() ? window.innerWidth : window.innerHeight) * 0.35;
    card.style.transition = 'transform 200ms ease';
    if (shortsLastDy < -threshold) {
      shortsCommit('up');
    } else if (shortsLastDy > threshold) {
      shortsCommit('down');
    } else {
      card.style.transform = shortsAxisProp() + '(0)';
    }
  }

  return {
    login, logout, checkSession, switchTab, onSearch, toggleMobileMenu, selectLabelFilter,
    addUploadRow, applyBulkLabel, toggleSelectAllRows, submitUpload, selectRowLabel,
    openDetail, closeDetail, onOverlayClick, onBackdropMouseDown, openSourceUrl,
    submitEvaluation, updateEvaluation, deletePost, deleteEvaluation, submitDetailComment, deleteDetailComment,
    copyTrainingData, closeExportDialog, onExportBackdropClick, copyExportText,
    openCriteriaEditor, closeCriteriaEditor, onCriteriaBackdropClick, saveCriteria,
    toggleShortsCriteria,
    openShorts, closeShorts, onShortsBackdropClick, toggleShortsHeart,
    openShortsComments, closeShortsComments, submitShortsComment, deleteShortsComment, shortsCommit
  };
})();

App.checkSession();
</script>

</body>
