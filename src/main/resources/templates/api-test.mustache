<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>얼마고 API 테스트</title>
<style>
  :root {
    --bg: #0f1115;
    --layer: #171a21;
    --layer-2: #1f242d;
    --border: #2c323d;
    --text: #e6e8ec;
    --muted: #9aa3b2;
    --primary: #ff6b35;
    --ok: #37b24d;
    --fail: #f03e3e;
    --warn: #f59f00;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 24px;
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    font-size: 14px; line-height: 1.5;
  }
  .wrap { max-width: 1100px; margin: 0 auto; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .sub { color: var(--muted); font-size: 13px; margin-bottom: 20px; }
  .tokenbar {
    position: sticky; top: 0; z-index: 10;
    background: var(--layer); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 14px; margin-bottom: 20px;
  }
  .tokenbar .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .pill {
    font-size: 12px; padding: 2px 8px; border-radius: 999px;
    border: 1px solid var(--border); color: var(--muted);
  }
  .pill.on { color: #fff; background: var(--ok); border-color: var(--ok); }
  .pill.off { color: #fff; background: var(--fail); border-color: var(--fail); }
  section {
    background: var(--layer); border: 1px solid var(--border); border-radius: 10px;
    padding: 16px; margin-bottom: 16px;
  }
  section > h2 {
    font-size: 15px; margin: 0 0 12px;
    display: flex; align-items: center; gap: 8px;
  }
  section > h2 .step {
    background: var(--primary); color: #fff; font-size: 11px;
    width: 20px; height: 20px; border-radius: 5px;
    display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto;
  }
  .ep { color: var(--muted); font-size: 12px; font-weight: 400; font-family: ui-monospace, Menlo, monospace; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
  label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 4px; }
  input, select, textarea {
    width: 100%; background: var(--layer-2); color: var(--text);
    border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px;
    font-size: 13px; font-family: inherit;
  }
  textarea { min-height: 64px; resize: vertical; }
  .btns { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  button {
    background: var(--primary); color: #fff; border: 0; border-radius: 6px;
    padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer;
    font-family: inherit;
  }
  button.ghost { background: transparent; border: 1px solid var(--border); color: var(--text); font-weight: 400; }
  button:active { transform: translateY(1px); }
  .out {
    margin-top: 12px; background: #0b0d11; border: 1px solid var(--border);
    border-radius: 8px; padding: 10px; font-family: ui-monospace, Menlo, monospace;
    font-size: 12px; white-space: pre-wrap; word-break: break-all;
    max-height: 320px; overflow: auto; display: none;
  }
  .out.show { display: block; }
  .status { font-weight: 700; }
  .status.s2 { color: var(--ok); }
  .status.s4 { color: var(--warn); }
  .status.s5 { color: var(--fail); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; margin-top: 12px; }
  .card { background: var(--layer-2); border: 1px solid var(--border); border-radius: 8px; padding: 10px; font-size: 12px; }
  .card img { width: 100%; height: 110px; object-fit: cover; border-radius: 6px; background: #000; margin-bottom: 8px; }
  .card .t { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .card .m { color: var(--muted); }
  .hint { color: var(--muted); font-size: 12px; margin-top: 8px; }
  .inline { display: flex; gap: 8px; align-items: flex-end; }
  .inline > div { flex: 1; }
  .toggles { display: flex; flex-wrap: wrap; gap: 8px; }
  .toggle {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--layer-2); border: 1px solid var(--border);
    border-radius: 999px; padding: 6px 12px; font-size: 12px; cursor: pointer;
  }
  .toggle.on { border-color: var(--ok); color: #fff; background: rgba(55,178,77,.18); }
  .toggle .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border); }
  .toggle.on .dot { background: var(--ok); }
  .toggle .sub2 { color: var(--muted); }
  .empty { color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>얼마고 API 테스트</h1>
  <div class="sub">위에서 아래로 순서대로 실행하면 로그인부터 핫딜 업로드 · 검증 · 조회까지 전 과정을 확인할 수 있습니다.</div>

  <div class="tokenbar">
    <div class="row">
      <span class="pill" id="tokenState">토큰 없음</span>
      <span class="pill" id="newUserState">가입여부 미확인</span>
      <button class="ghost" onclick="copyToken()">액세스 토큰 복사</button>
      <button class="ghost" onclick="clearTokens()">토큰 초기화</button>
    </div>
    <div class="row" style="margin-top:10px">
      <div style="flex:1; min-width:280px">
        <label>액세스 토큰 직접 입력 (스웨거에서 받은 토큰 붙여넣기)</label>
        <input id="manualToken" placeholder="eyJhbGciOiJIUzI1NiJ9...">
      </div>
      <button class="ghost" onclick="saveManualToken()">저장</button>
    </div>
  </div>

  <section>
    <h2><span class="step">1</span> 소셜 로그인 <span class="ep">GET /oauth2/authorization/{provider}</span></h2>
    <div class="btns">
      <button onclick="login('kakao')">카카오로 로그인</button>
      <button onclick="login('google')">구글로 로그인</button>
      <button class="ghost" onclick="run('auth', 'POST', '/api/v1/auth/refresh', null, true)">리프레시 토큰으로 재발급</button>
      <button class="ghost" onclick="run('auth', 'GET', '/api/v1/users/health')">헬스체크</button>
    </div>
    <div class="hint">로그인하면 이 페이지로 돌아오면서 accessToken · refreshToken · isNewUser 가 쿼리로 전달되고 자동 저장됩니다.</div>
    <div class="out" id="out-auth"></div>
  </section>

  <section>
    <h2><span class="step">2</span> 회원가입 <span class="ep">POST /api/v1/users/signup</span></h2>
    <div class="grid">
      <div>
        <label>닉네임 (필수)</label>
        <input id="su-nickname" placeholder="짠돌이">
      </div>
      <div>
        <label>프로필 이미지 (선택)</label>
        <input id="su-file" type="file" accept="image/*">
      </div>
    </div>
    <div class="btns"><button onclick="signup()">회원가입</button></div>
    <div class="hint">isNewUser 가 true 일 때 호출합니다. 이미 가입된 사용자는 아무것도 바뀌지 않고 성공 응답이 옵니다.</div>
    <div class="out" id="out-signup"></div>
  </section>

  <section>
    <h2><span class="step">3</span> 카테고리 조회 <span class="ep">GET /api/v1/categories</span></h2>
    <div class="btns"><button onclick="loadCategories()">카테고리 불러오기</button></div>
    <div class="hint">불러오면 아래 업로드 · 목록조회 · 알림설정의 카테고리 선택값이 함께 채워집니다.</div>
    <div class="out" id="out-category"></div>
  </section>

  <section>
    <h2><span class="step">4</span> 판매처 찾기 <span class="ep">POST /api/v1/stores/search · GET /api/v1/stores</span></h2>
    <div class="inline">
      <div>
        <label>상품 링크로 판매처 식별</label>
        <input id="st-link" placeholder="https://www.coupang.com/vp/products/123">
      </div>
      <button onclick="searchStoreByLink()">식별</button>
    </div>
    <div class="inline" style="margin-top:10px">
      <div>
        <label>판매처명으로 검색 (비우면 전체)</label>
        <input id="st-keyword" placeholder="네이버">
      </div>
      <button class="ghost" onclick="searchStoreByName()">검색</button>
    </div>
    <div class="hint">식별 · 검색 결과의 storeId 는 아래 업로드 폼에 자동으로 채워집니다.</div>
    <div class="out" id="out-store"></div>
  </section>

  <section>
    <h2><span class="step">5</span> 핫딜 업로드 <span class="ep">POST /api/v1/deal-posts</span></h2>
    <div class="grid">
      <div>
        <label>구매 링크 (필수)</label>
        <input id="dp-link" placeholder="https://www.coupang.com/vp/products/123">
      </div>
      <div>
        <label>상품명</label>
        <input id="dp-name" placeholder="에어팟 프로 2세대">
      </div>
      <div>
        <label>가격</label>
        <input id="dp-price" type="number" placeholder="289000">
      </div>
      <div>
        <label>카테고리 (필수)</label>
        <select id="dp-category"><option value="">먼저 카테고리를 불러오세요</option></select>
      </div>
      <div>
        <label>판매처 ID (선택)</label>
        <input id="dp-store" type="number" placeholder="비우면 판매처 없이 등록">
      </div>
      <div>
        <label>이미지 (최대 10개, 선택)</label>
        <input id="dp-files" type="file" accept="image/*" multiple>
      </div>
    </div>
    <div style="margin-top:10px">
      <label>본문</label>
      <textarea id="dp-content" placeholder="핫딜 설명을 적어주세요."></textarea>
    </div>
    <div class="btns">
      <button onclick="uploadDealPost()">업로드</button>
      <button class="ghost" onclick="uploadAndVerify()">업로드 후 검증 3단계 연속 실행</button>
    </div>
    <div class="hint">업로드된 글은 HOLD 상태라 목록에 안 보입니다. 아래 검증 3단계를 모두 통과해야 ACTIVE 가 됩니다.</div>
    <div class="out" id="out-upload"></div>
  </section>

  <section>
    <h2><span class="step">6</span> 검증 3단계 <span class="ep">POST /api/v1/deal-posts/{id}/verifications/*</span></h2>
    <div class="inline">
      <div>
        <label>핫딜 글 ID</label>
        <input id="vf-id" type="number" placeholder="업로드하면 자동 입력됩니다">
      </div>
    </div>
    <div class="btns">
      <button onclick="verify('link')">1단계 · 제휴링크</button>
      <button onclick="verify('reliability')">2단계 · 업로드자 신뢰도</button>
      <button onclick="verify('advertisement')">3단계 · 광고글</button>
      <button class="ghost" onclick="verifyAll()">3단계 연속 실행</button>
    </div>
    <div class="hint">탈락은 에러가 아니라 200 응답의 passed=false 로 내려옵니다. 3단계를 모두 통과하면 dealPostStatus 가 ACTIVE 로 바뀝니다.</div>
    <div class="out" id="out-verify"></div>
  </section>

  <section>
    <h2><span class="step">7</span> 핫딜 목록 조회 <span class="ep">GET /api/v1/deal-posts</span></h2>
    <div class="grid">
      <div>
        <label>카테고리</label>
        <select id="ls-category"><option value="">전체</option></select>
      </div>
      <div>
        <label>검색어 (상품명)</label>
        <input id="ls-keyword" placeholder="에어팟">
      </div>
      <div>
        <label>정렬</label>
        <select id="ls-sort">
          <option value="latest">최신순</option>
          <option value="price">가격순 (저렴한 순)</option>
          <option value="grade">등급순 (업로드자 등급 높은 순)</option>
        </select>
      </div>
      <div>
        <label>종료된 핫딜</label>
        <select id="ls-ended">
          <option value="false">포함 (기본)</option>
          <option value="true">제외</option>
        </select>
      </div>
      <div>
        <label>핫딜 필터</label>
        <select id="ls-hotdeal">
          <option value="false">끄기 (기본)</option>
          <option value="true">켜기 (중수 이상 · 신뢰도 9 이하)</option>
        </select>
      </div>
      <div>
        <label>페이지 / 크기</label>
        <div style="display:flex; gap:6px">
          <input id="ls-page" type="number" value="0">
          <input id="ls-size" type="number" value="20">
        </div>
      </div>
    </div>
    <div class="btns">
      <button onclick="searchDealPosts()">조회</button>
      <button class="ghost" onclick="searchDealPosts(true)">잘못된 정렬값으로 호출 (400 확인)</button>
    </div>
    <div class="cards" id="dealPostCards"></div>
    <div class="out" id="out-list"></div>
  </section>

  <section>
    <h2><span class="step">8</span> 알림 설정 조회 · 등록 · 삭제 <span class="ep">GET · POST · DELETE /api/v1/alerts</span></h2>
    <div class="grid">
      <div>
        <label>키워드 알림</label>
        <input id="al-keyword" placeholder="에어팟">
      </div>
      <div>
        <label>카테고리 알림</label>
        <select id="al-category"><option value="">선택 안 함</option></select>
      </div>
    </div>
    <div class="btns">
      <button onclick="loadMyAlerts()">카테고리 알림</button>
      <button onclick="registerAlert()">위 입력값으로 등록</button>
      <button class="ghost" onclick="registerAlert(true)">둘 다 비우고 호출 (400 확인)</button>
    </div>
    <div class="hint">둘 다 입력하면 키워드가 우선 적용되고 카테고리는 무시됩니다.</div>
    <div class="inline" style="margin-top:12px">
      <div>
        <label>삭제할 알림 설정 ID</label>
        <input id="al-id" type="number" placeholder="1">
      </div>
      <button class="ghost" onclick="deleteAlert()">삭제</button>
    </div>
    <div class="hint">본인이 등록한 알림만 삭제됩니다. 없는 ID 나 남의 알림은 둘 다 404 입니다.</div>

    <div style="margin-top:14px">
      <label>카테고리 알림 — 카테고리를 클릭하면 등록되고, 켜진 걸 다시 누르면 해제됩니다</label>
      <div id="categoryAlerts" class="toggles"><span class="empty">위의 "카테고리 알림" 버튼을 누르세요.</span></div>
      <label style="margin-top:12px">키워드 알림 — 클릭하면 삭제됩니다</label>
      <div id="keywordAlerts" class="toggles"><span class="empty">-</span></div>
    </div>
    <div class="out" id="out-alert"></div>
  </section>

  <section>
    <h2><span class="step">9</span> 내 알림 조회 <span class="ep">GET /api/v1/notifications</span></h2>
    <div class="btns"><button onclick="run('notification', 'GET', '/api/v1/notifications')">조회</button></div>
    <div class="out" id="out-notification"></div>
  </section>
</div>

<script>
  var RANK_LABEL = {
    STARTER: '짠돌 입문', BEGINNER: '짠돌 초수', INTERMEDIATE: '짠돌 중수',
    EXPERT: '짠돌 고수', MASTER: '짠돌 9단'
  };

  function el(id) { return document.getElementById(id); }
  function accessToken() { return localStorage.getItem('accessToken') || ''; }
  function refreshToken() { return localStorage.getItem('refreshToken') || ''; }

  function renderTokenState() {
    var t = el('tokenState');
    if (accessToken()) {
      t.textContent = '액세스 토큰 보유';
      t.className = 'pill on';
    } else {
      t.textContent = '토큰 없음';
      t.className = 'pill off';
    }
    var n = el('newUserState');
    var isNew = localStorage.getItem('isNewUser');
    if (isNew === null) {
      n.textContent = '가입여부 미확인';
      n.className = 'pill';
    } else if (isNew === 'true') {
      n.textContent = '신규 사용자 - 회원가입 필요';
      n.className = 'pill off';
    } else {
      n.textContent = '기존 사용자';
      n.className = 'pill on';
    }
  }

  function show(key, status, body, note) {
    var box = el('out-' + key);
    var cls = status >= 500 ? 's5' : (status >= 400 ? 's4' : 's2');
    var head = '<span class="status ' + cls + '">HTTP ' + status + '</span>';
    if (note) head += '  ' + note;
    box.innerHTML = head + '\n' + body;
    box.className = 'out show';
  }

  function pretty(text) {
    try {
      return JSON.stringify(JSON.parse(text), null, 2);
    } catch (e) {
      return text;
    }
  }

  async function request(method, url, body, useRefreshToken) {
    var headers = {};
    var token = useRefreshToken ? refreshToken() : accessToken();
    if (token) headers['Authorization'] = 'Bearer ' + token;
    if (body && !(body instanceof FormData)) headers['Content-Type'] = 'application/json';

    var res = await fetch(url, { method: method, headers: headers, body: body || undefined });
    var text = await res.text();
    return { status: res.status, text: text, json: safeJson(text) };
  }

  function safeJson(text) {
    try { return JSON.parse(text); } catch (e) { return null; }
  }

  async function run(key, method, url, body, useRefreshToken) {
    try {
      var r = await request(method, url, body, useRefreshToken);
      show(key, r.status, pretty(r.text));
      return r;
    } catch (e) {
      show(key, 0, '요청 실패: ' + e.message);
      return null;
    }
  }

  function login(provider) {
    var redirectUri = location.origin + '/test';
    location.href = '/oauth2/authorization/' + provider + '?redirectUri=' + encodeURIComponent(redirectUri);
  }

  function saveManualToken() {
    var v = el('manualToken').value.trim();
    if (!v) return;
    localStorage.setItem('accessToken', v.replace(/^Bearer\s+/i, ''));
    el('manualToken').value = '';
    renderTokenState();
  }

  function copyToken() {
    if (!accessToken()) return;
    navigator.clipboard.writeText(accessToken());
  }

  function clearTokens() {
    localStorage.removeItem('accessToken');
    localStorage.removeItem('refreshToken');
    localStorage.removeItem('isNewUser');
    renderTokenState();
  }

  async function signup() {
    var nickname = el('su-nickname').value;
    var fd = new FormData();
    fd.append('request', new Blob([JSON.stringify({ nickname: nickname })], { type: 'application/json' }));
    var f = el('su-file').files[0];
    if (f) fd.append('file', f);

    var r = await run('signup', 'POST', '/api/v1/users/signup', fd);
    if (r && r.status === 200) {
      localStorage.setItem('isNewUser', 'false');
      renderTokenState();
    }
  }

  async function loadCategories() {
    var r = await run('category', 'GET', '/api/v1/categories');
    if (!r || !r.json || !r.json.data) return;
    var list = r.json.data.categories || [];
    ['dp-category', 'ls-category', 'al-category'].forEach(function (id) {
      var sel = el(id);
      var blank = id === 'dp-category' ? '선택하세요' : (id === 'ls-category' ? '전체' : '선택 안 함');
      sel.innerHTML = '<option value="">' + blank + '</option>';
      list.forEach(function (c) {
        var o = document.createElement('option');
        o.value = c.categoryId;
        o.textContent = c.categoryName + ' (' + c.categoryId + ')';
        sel.appendChild(o);
      });
    });
  }

  async function searchStoreByLink() {
    var link = el('st-link').value;
    var r = await run('store', 'POST', '/api/v1/stores/search', JSON.stringify({ purchaseLink: link }));
    if (r && r.json && r.json.data && r.json.data.storeId) {
      el('dp-store').value = r.json.data.storeId;
      if (!el('dp-link').value) el('dp-link').value = link;
    }
  }

  async function searchStoreByName() {
    var keyword = el('st-keyword').value;
    var url = '/api/v1/stores' + (keyword ? '?keyword=' + encodeURIComponent(keyword) : '');
    var r = await run('store', 'GET', url);
    if (r && r.json && r.json.data) {
      var stores = r.json.data.stores || [];
      if (stores.length > 0) el('dp-store').value = stores[0].storeId;
    }
  }

  function dealPostFormData() {
    var payload = {
      purchaseLink: el('dp-link').value,
      productName: el('dp-name').value,
      productPrice: el('dp-price').value ? Number(el('dp-price').value) : null,
      categoryId: el('dp-category').value ? Number(el('dp-category').value) : null,
      storeId: el('dp-store').value ? Number(el('dp-store').value) : null,
      content: el('dp-content').value
    };
    var fd = new FormData();
    fd.append('request', new Blob([JSON.stringify(payload)], { type: 'application/json' }));
    var files = el('dp-files').files;
    for (var i = 0; i < files.length; i++) fd.append('files', files[i]);
    return fd;
  }

  async function uploadDealPost() {
    var r = await run('upload', 'POST', '/api/v1/deal-posts', dealPostFormData());
    if (r && r.json && r.json.data && r.json.data.dealPostId) {
      el('vf-id').value = r.json.data.dealPostId;
    }
    return r;
  }

  async function verify(step) {
    var id = el('vf-id').value;
    if (!id) {
      show('verify', 0, '핫딜 글 ID 를 먼저 입력하세요.');
      return null;
    }
    return await run('verify', 'POST', '/api/v1/deal-posts/' + id + '/verifications/' + step);
  }

  async function verifyAll() {
    var steps = ['link', 'reliability', 'advertisement'];
    var labels = { link: '1단계 제휴링크', reliability: '2단계 신뢰도', advertisement: '3단계 광고글' };
    var id = el('vf-id').value;
    if (!id) {
      show('verify', 0, '핫딜 글 ID 를 먼저 입력하세요.');
      return;
    }
    var lines = [];
    var lastStatus = 200;
    for (var i = 0; i < steps.length; i++) {
      var r = await request('POST', '/api/v1/deal-posts/' + id + '/verifications/' + steps[i]);
      lastStatus = r.status;
      var mark = 'HTTP ' + r.status;
      if (r.json && r.json.data) {
        mark += ' / passed=' + r.json.data.passed + ' / status=' + r.json.data.dealPostStatus;
      } else if (r.json) {
        mark += ' / ' + r.json.statusCode + ' - ' + r.json.message;
      }
      lines.push('[' + labels[steps[i]] + '] ' + mark);
      lines.push(pretty(r.text));
      lines.push('');
    }
    show('verify', lastStatus, lines.join('\n'), '(3단계 연속 실행)');
  }

  async function uploadAndVerify() {
    var r = await uploadDealPost();
    if (!r || r.status >= 400) return;
    await verifyAll();
  }

  async function searchDealPosts(useBrokenSort) {
    var params = new URLSearchParams();
    if (el('ls-category').value) params.set('category', el('ls-category').value);
    if (el('ls-keyword').value) params.set('keyword', el('ls-keyword').value);
    params.set('sortType', useBrokenSort ? 'NOT_EXIST_SORT' : el('ls-sort').value);
    params.set('ended', el('ls-ended').value);
    params.set('hotDeal', el('ls-hotdeal').value);
    params.set('page', el('ls-page').value || '0');
    params.set('size', el('ls-size').value || '20');

    var r = await run('list', 'GET', '/api/v1/deal-posts?' + params.toString());
    renderDealPosts(r && r.json && r.json.data ? r.json.data.dealPosts : []);
  }

  function renderDealPosts(posts) {
    var box = el('dealPostCards');
    box.innerHTML = '';
    if (!posts || posts.length === 0) return;
    posts.forEach(function (p) {
      var div = document.createElement('div');
      div.className = 'card';
      var img = p.thumbnailImageUrl
        ? '<img src="' + p.thumbnailImageUrl + '" alt="">'
        : '<img src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciLz4=" alt="">';
      div.innerHTML = img
        + '<div class="t">' + (p.productName || '(상품명 없음)') + '</div>'
        + '<div class="m">' + (p.storeName || '판매처 미지정') + ' · ' + (p.productPrice || 0).toLocaleString() + '원</div>'
        + '<div class="m">' + (RANK_LABEL[p.uploaderRank] || p.uploaderRank || '-') + ' · ' + p.dealPostStatus + '</div>'
        + '<div class="m">추천 ' + p.likeCount + ' · 조회 ' + p.viewCount + ' · 댓글 ' + p.commentCount + '</div>'
        + '<div class="m">id ' + p.dealPostId + ' · ' + (p.createdAt || '').replace('T', ' ').slice(0, 19) + '</div>';
      box.appendChild(div);
    });
  }

  async function registerAlert(sendEmpty) {
    var payload = {};
    if (!sendEmpty) {
      var keyword = el('al-keyword').value;
      var categoryId = el('al-category').value;
      if (keyword) payload.keyword = keyword;
      if (categoryId) payload.categoryId = Number(categoryId);
    }
    await run('alert', 'POST', '/api/v1/alerts', JSON.stringify(payload));
  }

  async function loadMyAlerts() {
    var r = await run('alert', 'GET', '/api/v1/alerts');

    if (!r || !r.json || !r.json.data) {
      el('categoryAlerts').innerHTML =
        '<span class="empty">조회 실패 - 아래 응답을 확인하세요. 토큰이 없으면 1번에서 로그인하세요.</span>';
      el('keywordAlerts').innerHTML = '<span class="empty">-</span>';
      return;
    }

    var d = r.json.data;
    var lines = ['[카테고리 알림]'];
    (d.categories || []).forEach(function (c) {
      lines.push('  ' + (c.enabled ? '[ON ]' : '[OFF]') + ' ' + c.categoryName
        + ' (categoryId=' + c.categoryId + ', alertId=' + c.alertId + ')');
    });
    lines.push('[키워드 알림]');
    if ((d.keywords || []).length === 0) lines.push('  (없음)');
    (d.keywords || []).forEach(function (k) {
      lines.push('  ' + k.keyword + ' (alertId=' + k.alertId + ')');
    });
    lines.push('');
    lines.push(pretty(r.text));
    show('alert', r.status, lines.join('\n'), '(내 알림 설정)');

    renderAlertPanel(d);

    var enabled = (d.categories || []).filter(function (c) { return c.enabled; });
    if (enabled.length > 0) el('al-id').value = enabled[0].alertId;
    else if ((d.keywords || []).length > 0) el('al-id').value = d.keywords[0].alertId;
  }

  function renderAlertPanel(d) {
    var cats = el('categoryAlerts');
    cats.innerHTML = '';
    (d.categories || []).forEach(function (c) {
      var b = document.createElement('div');
      b.className = 'toggle' + (c.enabled ? ' on' : '');
      b.innerHTML = '<span class="dot"></span>' + c.categoryName
        + '<span class="sub2">' + (c.enabled ? 'alertId ' + c.alertId : 'OFF') + '</span>';
      b.onclick = function () { toggleCategoryAlert(c); };
      cats.appendChild(b);
    });
    if ((d.categories || []).length === 0) {
      cats.innerHTML = '<span class="empty">카테고리가 없습니다. 3번에서 카테고리를 먼저 등록하세요.</span>';
    }

    var keys = el('keywordAlerts');
    keys.innerHTML = '';
    (d.keywords || []).forEach(function (k) {
      var b = document.createElement('div');
      b.className = 'toggle on';
      b.innerHTML = '<span class="dot"></span>' + k.keyword
        + '<span class="sub2">삭제 (alertId ' + k.alertId + ')</span>';
      b.onclick = function () { removeAlert(k.alertId); };
      keys.appendChild(b);
    });
    if ((d.keywords || []).length === 0) {
      keys.innerHTML = '<span class="empty">등록한 키워드 알림이 없습니다.</span>';
    }
  }

  async function toggleCategoryAlert(category) {
    if (category.enabled) {
      await removeAlert(category.alertId);
      return;
    }
    var r = await request('POST', '/api/v1/alerts',
      JSON.stringify({ categoryId: category.categoryId }));
    show('alert', r.status, pretty(r.text), '(' + category.categoryName + ' 알림 켜기)');
    await loadMyAlerts();
  }

  async function removeAlert(alertId) {
    var r = await request('DELETE', '/api/v1/alerts/' + alertId);
    show('alert', r.status, pretty(r.text), '(alertId ' + alertId + ' 삭제)');
    await loadMyAlerts();
  }

  async function deleteAlert() {
    var id = el('al-id').value;
    if (!id) {
      show('alert', 0, '삭제할 알림 설정 ID 를 입력하세요.');
      return;
    }
    await run('alert', 'DELETE', '/api/v1/alerts/' + id);
  }

  (function init() {
    var q = new URLSearchParams(location.search);
    if (q.get('accessToken')) {
      localStorage.setItem('accessToken', q.get('accessToken'));
      if (q.get('refreshToken')) localStorage.setItem('refreshToken', q.get('refreshToken'));
      if (q.get('isNewUser')) localStorage.setItem('isNewUser', q.get('isNewUser'));
      history.replaceState(null, '', location.pathname);
    }
    renderTokenState();
  })();
</script>
</body>
</html>
