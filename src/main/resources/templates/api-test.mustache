<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>얼마고 프로토타입</title>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f0f0f0; font-size: 13px; font-family: sans-serif; color: #111; }
  .phone { width: 393px; margin: 0 auto; background: #fff; border: 1px solid #000; min-height: 852px; padding-bottom: 70px; position: relative; }
  .screen { display: none; }
  .screen.on { display: block; }
  .bar { border-bottom: 1px solid #000; padding: 10px 12px; display: flex; align-items: center; gap: 8px; }
  .bar .title { flex: 1; text-align: center; font-weight: bold; }
  .pad { padding: 12px; }
  .box { border: 1px solid #000; padding: 10px; margin-bottom: 8px; }
  .ph { border: 1px dashed #999; color: #666; padding: 20px; text-align: center; }
  .label { margin: 12px 0 4px; color: #666; }
  input, textarea, select { width: 100%; padding: 7px; border: 1px solid #000; font-size: 13px; font-family: inherit; background: #fff; border-radius: 0; }
  textarea { min-height: 80px; }
  button { font-family: inherit; font-size: 13px; border: 1px solid #000; background: #fff; padding: 8px 12px; cursor: pointer; border-radius: 0; }
  button.wide { width: 100%; padding: 12px; }
  button.fill { background: #000; color: #fff; }
  button:disabled, .off { color: #999; border-color: #999; cursor: default; }
  .row { display: flex; gap: 6px; align-items: center; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .chip { border: 1px solid #000; padding: 4px 8px; cursor: pointer; }
  .chip.on { background: #000; color: #fff; }
  .deal { border-bottom: 1px solid #000; padding: 10px 12px; display: flex; gap: 10px; }
  .deal .thumb { width: 60px; height: 60px; border: 1px dashed #999; object-fit: cover; flex: 0 0 auto; }
  .deal .sub { color: #666; }
  .deal .price { font-weight: bold; font-size: 15px; }
  .tag { border: 1px solid #000; padding: 0 4px; font-size: 11px; }
  .tabbar { position: absolute; bottom: 0; left: 0; width: 100%; border-top: 1px solid #000; display: flex; }
  .tabbar div { flex: 1; text-align: center; padding: 12px 0; border-right: 1px solid #000; cursor: pointer; }
  .tabbar div:last-child { border-right: 0; }
  .tabbar div.on { background: #000; color: #fff; }
  .steps div { border: 1px solid #000; padding: 8px; margin-bottom: 6px; }
  .steps div.doing { background: #ddd; }
  .steps div.done { background: #000; color: #fff; }
  .steps div.fail { border-width: 3px; }
  .noti { border-bottom: 1px solid #000; padding: 10px 12px; }
  .noti.unread { background: #eee; }
  .muted { color: #666; }
  .sec { padding: 8px 12px; background: #eee; border-bottom: 1px solid #000; font-weight: bold; }
  .log { position: fixed; right: 8px; bottom: 8px; width: 420px; max-height: 44vh; overflow: auto; background: #fff; border: 1px solid #000; font-family: monospace; font-size: 11px; white-space: pre-wrap; word-break: break-all; padding: 8px; display: none; }
  .log.on { display: block; }
  .logbtn { position: fixed; right: 8px; top: 8px; }
  .devbar { border-bottom: 1px solid #000; background: #eee; padding: 5px 8px; font-size: 11px; }
  .devbar input { display: inline-block; width: 140px; padding: 2px 4px; font-size: 11px; }
  .devbar button { padding: 2px 6px; font-size: 11px; }
</style>
</head>
<body>

<button class="logbtn" onclick="document.getElementById('log').classList.toggle('on')">API 로그</button>
<div class="log" id="log"></div>

<div class="phone">

  <div class="devbar">
    <span id="devToken">토큰 없음</span>
    <input id="devInput" placeholder="액세스 토큰 붙여넣기">
    <button onclick="saveToken()">저장</button>
    <button onclick="logout()">초기화</button>
  </div>

  <!-- 1-1 스플래시 -->
  <div class="screen on" id="s-splash">
    <div class="pad" style="text-align:center; padding-top:300px">
      <div class="ph" style="width:80px; height:80px; padding:0; line-height:80px; margin:0 auto">로고</div>
      <div style="font-size:22px; font-weight:bold; margin-top:16px">얼마고?</div>
      <button class="wide" style="margin-top:40px" onclick="go('login')">시작</button>
    </div>
  </div>

  <!-- 1-2 로그인 -->
  <div class="screen" id="s-login">
    <div class="pad">
      <div class="ph" style="width:60px; height:60px; padding:0; line-height:60px; margin:60px 0 20px">로고</div>
      <div style="font-size:22px; font-weight:bold; line-height:1.4">사기 전에 한 번,<br>얼마고?</div>
      <div class="muted" style="margin-top:10px">나만의 장보기 꿀팁을 나누는<br>짠돌이들의 핫딜 커뮤니티</div>
      <div style="margin-top:320px">
        <button class="wide fill" onclick="login('kakao')">카카오로 시작하기</button>
        <button class="wide" style="margin-top:8px" onclick="login('google')">Google로 시작하기</button>
        <div class="muted" style="text-align:center; margin-top:10px; font-size:11px">
          시작하면 서비스 이용약관 및 개인정보 처리방침에 동의하게 돼요
        </div>
      </div>
    </div>
  </div>

  <!-- 1-3 온보딩 1 짠돌 등급 -->
  <div class="screen" id="s-onboard1">
    <div class="bar"><span style="flex:1"></span><button onclick="go('profile')">건너뛰기</button></div>
    <div class="pad">
      <div class="box">
        <div class="row"><div class="ph" style="width:28px; height:28px; padding:0; line-height:28px">님</div>
          <div><div>짠돌이자취러 <span class="tag">짠돌초수</span></div>
            <div class="muted">신라면 멀티팩 40개입 핫딜을 공유했어요!</div></div></div>
      </div>
      <div class="chips" style="align-items:flex-end; height:160px; margin:20px 0">
        <div class="box" style="height:40px; margin:0">짠돌입문</div>
        <div class="box" style="height:70px; margin:0">짠돌초수</div>
        <div class="box" style="height:100px; margin:0">짠돌중수</div>
        <div class="box" style="height:130px; margin:0">짠돌고수</div>
        <div class="box" style="height:160px; margin:0">짠돌9단</div>
      </div>
      <div style="font-size:18px; font-weight:bold; line-height:1.4">꿀팁을 나눌수록<br>짠돌 등급이 올라가요</div>
      <div class="muted" style="margin-top:8px">짠돌입문부터 짠돌9단까지!<br>핫딜을 나누고 추천을 모아 승급할 수 있어요.</div>
      <button class="wide fill" style="margin-top:24px" onclick="go('onboard2')">다음</button>
    </div>
  </div>

  <!-- 1-4 온보딩 2 업적과 짠돌주화 -->
  <div class="screen" id="s-onboard2">
    <div class="bar"><span style="flex:1"></span><button onclick="go('profile')">건너뛰기</button></div>
    <div class="pad">
      <div class="ph" style="width:70px; height:70px; padding:0; line-height:70px; margin:10px auto">업적</div>
      <div class="box row" style="justify-content:space-between"><span>첫 핫딜 공유하기</span><span class="tag">+10</span></div>
      <div class="box row" style="justify-content:space-between"><span>도움돼요 50개 받기</span><span class="tag">+30</span></div>
      <div class="box row" style="justify-content:space-between"><span>7일 연속 방문하기</span><span class="tag">+20</span></div>
      <div style="font-size:18px; font-weight:bold; line-height:1.4; margin-top:20px">업적을 달성하면<br>짠돌주화를 받아요</div>
      <div class="muted" style="margin-top:8px">업적을 깨고 짠돌주화를 모아보세요.<br>모은 주화는 질문과 승급에 쓸 수 있어요!</div>
      <button class="wide fill" style="margin-top:24px" onclick="go('profile')">시작하기</button>
    </div>
  </div>

  <!-- 1-2-2 프로필 설정 -->
  <div class="screen" id="s-profile">
    <div class="pad">
      <div style="font-size:18px; font-weight:bold; line-height:1.4; margin-top:20px">
        짠돌이들에게 보여줄<br>프로필을 만들어주세요
      </div>
      <div class="muted" style="margin-top:6px">닉네임은 한글 · 영문 · 숫자 2~10자예요</div>

      <div style="text-align:center; margin:24px 0">
        <img id="pf-preview" style="width:100px; height:100px; border:1px dashed #999; object-fit:cover">
        <div class="muted" style="margin:6px 0">프로필 이미지 (선택)</div>
        <input id="pf-file" type="file" accept="image/*" onchange="previewProfile()">
      </div>

      <div class="row">
        <input id="pf-nickname" placeholder="닉네임" maxlength="10" oninput="countNickname()">
        <button onclick="clearNickname()">지우기</button>
      </div>
      <div class="row" style="justify-content:space-between; margin-top:4px">
        <span class="muted" id="pf-help">닉네임을 입력해 주세요</span>
        <span class="muted" id="pf-count">0/10</span>
      </div>

      <button class="wide fill" style="margin-top:24px" onclick="signup()">다음</button>
    </div>
  </div>

  <!-- 2-1 홈 -->
  <div class="screen" id="s-home">
    <div class="bar">
      <div style="flex:1; font-size:18px; font-weight:bold">얼마고?</div>
      <button onclick="go('noti')">알림</button>
    </div>
    <div class="pad" style="padding-bottom:6px">
      <input id="h-keyword" placeholder="사기 전에 한 번, 검색해 보세요" onkeydown="if(event.key==='Enter')loadDeals()">
      <div class="chips" style="margin-top:8px" id="h-categories"></div>
      <div class="row" style="justify-content:space-between; margin-top:8px">
        <label class="muted"><input type="checkbox" id="h-ended" style="width:auto" onchange="loadDeals()"> 종료 제외</label>
        <select id="h-sort" style="width:auto" onchange="loadDeals()">
          <option value="latest">최신순</option>
          <option value="price">가격순</option>
          <option value="grade">등급순</option>
        </select>
      </div>
    </div>
    <div id="h-list"></div>

    <div class="tabbar">
      <div class="on" onclick="go('home')">홈</div>
      <div class="off">짠돌이들</div>
      <div onclick="openShare()">+ 글쓰기</div>
      <div class="off">바구니</div>
      <div class="off">마이</div>
    </div>
  </div>

  <!-- 2-2 핫딜 상세 -->
  <div class="screen" id="s-detail">
    <div class="bar">
      <button onclick="go('home')">뒤로</button>
      <div class="title"></div>
      <button class="off">공유</button>
      <button class="off">더보기</button>
    </div>
    <div id="d-images"></div>
    <div class="pad">
      <div class="muted" id="d-store"></div>
      <div style="font-size:16px; font-weight:bold; margin-top:4px" id="d-name"></div>
      <div class="row" style="justify-content:space-between; margin-top:4px">
        <div style="font-size:20px; font-weight:bold" id="d-price"></div>
        <button class="off">시세확인</button>
      </div>
    </div>
    <div class="pad" style="border-top:1px solid #000; border-bottom:1px solid #000">
      <div class="row">
        <img id="d-userimg" style="width:32px; height:32px; border:1px dashed #999; object-fit:cover">
        <div>
          <div><span id="d-nickname"></span> <span class="tag" id="d-rank"></span></div>
          <div class="muted"><span id="d-created"></span> · 조회 <span id="d-view"></span></div>
        </div>
      </div>
    </div>
    <div class="pad" id="d-content"></div>
    <div class="pad">
      <div class="label">구매 링크</div>
      <div class="box" id="d-link"></div>
      <div class="row">
        <button id="d-likebtn" onclick="react('like')">도움돼요 <span id="d-like"></span></button>
        <button id="d-dislikebtn" onclick="react('dislike')">별로예요 <span id="d-dislike"></span></button>
      </div>
      <div class="muted" id="d-reaction">내 반응: 없음</div>
      <div class="row" style="margin-top:8px">
        <button class="wide fill" onclick="openPurchaseLink()">구매하러 가기</button>
        <button class="off">담기</button>
      </div>
    </div>
    <div class="sec">댓글 <span id="d-commentcount"></span></div>
    <div id="d-comments"></div>
    <div class="pad"><button class="wide" onclick="writeComment(null)">댓글 작성</button></div>
  </div>

  <!-- 4-1 핫딜 공유 -->
  <div class="screen" id="s-share">
    <div class="bar"><button onclick="go('home')">닫기</button><div class="title">핫딜 공유</div><span style="width:40px"></span></div>
    <div class="pad">
      <div class="label">사진 <span id="sh-count">0/10</span></div>
      <input id="sh-files" type="file" accept="image/*" multiple onchange="countFiles()">

      <div class="label">구매 링크</div>
      <div class="row">
        <input id="sh-link" placeholder="https://..." onblur="detectStore()">
        <span class="chip" id="sh-store">판매처</span>
      </div>

      <div class="label">상품명</div>
      <input id="sh-name" placeholder="신라면 멀티팩 40개입">

      <div class="label">가격 (원)</div>
      <input id="sh-price" type="number" placeholder="25400">

      <div class="label">카테고리</div>
      <select id="sh-category"></select>

      <div class="label">본문</div>
      <textarea id="sh-content" placeholder="어떻게 싸게 샀는지 자유롭게 적어주세요"></textarea>

      <div class="muted" style="text-align:center; margin:16px 0 8px">공유하면 짠돌주화 10개를 받아요</div>
      <button class="wide fill" onclick="share()">공유하기</button>
    </div>
  </div>

  <!-- 4-3 검증 진행 / 4-4 공유 완료 -->
  <div class="screen" id="s-verify">
    <div class="pad" style="padding-top:40px">
      <div class="ph" style="width:100px; height:100px; padding:0; line-height:100px; margin:0 auto 20px">진행중</div>
      <div style="font-size:18px; font-weight:bold; text-align:center" id="vf-title">핫딜을 등록하고 있어요!</div>
      <div class="muted" style="text-align:center; margin:6px 0 20px" id="vf-sub">게시 내용을 살펴보는 중이에요</div>
      <div class="steps">
        <div id="vf-1">1단계 · 링크 확인</div>
        <div id="vf-2">2단계 · 신뢰도 측정</div>
        <div id="vf-3">3단계 · 광고글 여부 판단</div>
      </div>
      <div class="muted" style="text-align:center; margin-top:14px">보통 몇 초면 끝나요. 화면을 닫지 말고 기다려 주세요</div>
      <div id="vf-done" style="display:none; margin-top:24px">
        <div style="font-size:18px; font-weight:bold; text-align:center">공유 완료!</div>
        <button class="wide fill" style="margin-top:12px" onclick="go('home'); loadDeals()">홈으로</button>
      </div>
    </div>
  </div>

  <!-- 2-7 알림 -->
  <div class="screen" id="s-noti">
    <div class="bar">
      <button onclick="go('home')">뒤로</button>
      <div class="title">알림</div>
      <button class="off">모두 읽기</button>
    </div>
    <div class="pad" style="padding-bottom:0"><button onclick="go('alert')">알림 설정</button></div>
    <div id="n-list"></div>
  </div>

  <!-- 7-4 알림 설정 -->
  <div class="screen" id="s-alert">
    <div class="bar"><button onclick="go('noti')">뒤로</button><div class="title">알림 설정</div><span style="width:40px"></span></div>
    <div class="pad">
      <div class="box row" style="justify-content:space-between">
        <span>푸시 알림 받기</span><span class="muted">미구현</span>
      </div>
      <div class="label">카테고리 알림</div>
      <div class="box"><div class="chips" id="a-categories"></div></div>
      <div class="label">키워드 알림</div>
      <div class="box">
        <div class="chips" id="a-keywords"></div>
        <div class="row" style="margin-top:8px">
          <input id="a-keyword" placeholder="키워드 입력">
          <button onclick="addKeywordAlert()">+ 추가</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  var RANK = { STARTER: '짠돌 입문', BEGINNER: '짠돌 초수', INTERMEDIATE: '짠돌 중수', EXPERT: '짠돌 고수', MASTER: '짠돌 9단' };
  var selectedCategory = '';
  var lastDealPostId = null;

  function el(id) { return document.getElementById(id); }
  function token() { return localStorage.getItem('accessToken') || ''; }

  async function api(method, url, body) {
    var headers = {};
    if (token()) headers['Authorization'] = 'Bearer ' + token();
    if (body && !(body instanceof FormData)) headers['Content-Type'] = 'application/json';
    try {
      var res = await fetch(url, { method: method, headers: headers, body: body || undefined });
      var text = await res.text();
      el('log').textContent = '[' + res.status + '] ' + method + ' ' + url + '\n' + text
        + '\n\n' + el('log').textContent;
      var json = null;
      try { json = JSON.parse(text); } catch (e) { }
      return { ok: res.status < 400, status: res.status, json: json };
    } catch (e) {
      el('log').textContent = '[ERR] ' + method + ' ' + url + '\n' + e.message + '\n\n' + el('log').textContent;
      return { ok: false, status: 0, json: null };
    }
  }

  function go(name) {
    ['splash', 'login', 'onboard1', 'onboard2', 'profile', 'home', 'detail', 'share', 'verify', 'noti', 'alert']
      .forEach(function (s) {
      el('s-' + s).classList.toggle('on', s === name);
    });
    if (name === 'home') loadCategories();
    if (name === 'noti') loadNotifications();
    if (name === 'alert') loadAlerts();
    window.scrollTo(0, 0);
  }

  function login(provider) {
    location.href = '/oauth2/authorization/' + provider
      + '?redirectUri=' + encodeURIComponent(location.origin + '/test');
  }

  function saveToken() {
    localStorage.setItem('accessToken', el('devInput').value.trim().replace(/^Bearer\s+/i, ''));
    el('devInput').value = '';
    el('devToken').textContent = '토큰 보유';
    go('home');
    loadDeals();
  }

  function logout() {
    localStorage.clear();
    el('devToken').textContent = '토큰 없음';
    go('splash');
  }

  function previewProfile() {
    var f = el('pf-file').files[0];
    if (f) el('pf-preview').src = URL.createObjectURL(f);
  }

  function countNickname() {
    var v = el('pf-nickname').value;
    el('pf-count').textContent = v.length + '/10';
    el('pf-help').textContent = v.length >= 2 ? '사용할 수 있는 닉네임이에요' : '닉네임은 2자 이상이에요';
  }

  function clearNickname() {
    el('pf-nickname').value = '';
    countNickname();
  }

  async function signup() {
    var fd = new FormData();
    fd.append('request', new Blob([JSON.stringify({ nickname: el('pf-nickname').value })],
      { type: 'application/json' }));
    var f = el('pf-file').files[0];
    if (f) fd.append('file', f);

    var r = await api('POST', '/api/v1/users/signup', fd);
    if (!r.ok) { alert(r.json ? r.json.message : '회원가입 실패'); return; }
    localStorage.setItem('isNewUser', 'false');
    go('home');
    loadDeals();
  }

  async function loadCategories() {
    var r = await api('GET', '/api/v1/categories');
    var categories = (r.json && r.json.data && r.json.data.categories) || [];

    var home = el('h-categories');
    home.innerHTML = '';
    home.appendChild(chip('전체', selectedCategory === '', function () {
      selectedCategory = ''; loadCategories(); loadDeals();
    }));
    var popular = chip('인기', false, null);
    popular.className = 'chip off';
    home.appendChild(popular);
    categories.forEach(function (c) {
      home.appendChild(chip(c.categoryName, String(selectedCategory) === String(c.categoryId), function () {
        selectedCategory = c.categoryId; loadCategories(); loadDeals();
      }));
    });
    if (categories.length === 0) {
      home.appendChild(document.createTextNode(' 카테고리가 DB에 없습니다'));
    }

    var sel = el('sh-category');
    sel.innerHTML = '';
    categories.forEach(function (c) {
      var o = document.createElement('option');
      o.value = c.categoryId; o.textContent = c.categoryName;
      sel.appendChild(o);
    });
  }

  function chip(text, on, onclick) {
    var d = document.createElement('div');
    d.className = 'chip' + (on ? ' on' : '');
    d.textContent = text;
    if (onclick) d.onclick = onclick;
    return d;
  }

  async function loadDeals() {
    var p = new URLSearchParams();
    if (selectedCategory) p.set('category', selectedCategory);
    if (el('h-keyword').value) p.set('keyword', el('h-keyword').value);
    p.set('ended', el('h-ended').checked ? 'true' : 'false');
    p.set('sortType', el('h-sort').value);
    p.set('size', '20');

    var r = await api('GET', '/api/v1/deal-posts?' + p.toString());
    var list = el('h-list');
    list.innerHTML = '';

    var posts = (r.json && r.json.data && r.json.data.dealPosts) || [];
    if (posts.length === 0) {
      list.innerHTML = '<div class="pad muted">표시할 핫딜이 없어요.</div>';
      return;
    }

    posts.forEach(function (d) {
      var box = document.createElement('div');
      box.className = 'deal';
      box.style.cursor = 'pointer';
      box.onclick = function () { openDetail(d.dealPostId); };
      var thumb = d.thumbnailImageUrl
        ? '<img class="thumb" src="' + d.thumbnailImageUrl + '">'
        : '<div class="thumb">사진</div>';
      box.innerHTML = thumb
        + '<div style="flex:1">'
        + '<div class="sub">' + (d.storeName || '판매처 미지정')
        + (d.dealPostStatus === 'ENDED' ? ' <span class="tag">종료</span>' : '') + '</div>'
        + '<div>' + (d.productName || '-') + ' <span class="sub">댓글 ' + d.commentCount + '</span></div>'
        + '<div class="price">' + (d.productPrice || 0).toLocaleString() + '원</div>'
        + '<div class="sub"><span class="tag">' + (RANK[d.uploaderRank] || '-') + '</span>'
        + ' 추천 ' + d.likeCount + ' · 조회 ' + d.viewCount + ' · ' + timeAgo(d.createdAt) + '</div>'
        + '</div>';
      list.appendChild(box);
    });
  }

  function timeAgo(iso) {
    if (!iso) return '-';
    var diff = (Date.now() - new Date(iso).getTime()) / 60000;
    if (diff < 60) return Math.max(1, Math.floor(diff)) + '분 전';
    if (diff < 1440) return Math.floor(diff / 60) + '시간 전';
    return Math.floor(diff / 1440) + '일 전';
  }

  var detailLink = '';

  async function openDetail(dealPostId) {
    go('detail');
    detailId = dealPostId;
    renderReaction('NONE');
    var r = await api('GET', '/api/v1/deal-posts/' + dealPostId);
    if (!r.ok) { alert(r.json ? r.json.message : '조회 실패'); return; }
    var d = r.json.data;

    var imgs = el('d-images');
    imgs.innerHTML = '';
    if ((d.imageFileUrlList || []).length === 0) {
      imgs.innerHTML = '<div class="ph" style="height:200px; line-height:180px">사진 없음</div>';
    } else {
      d.imageFileUrlList.forEach(function (u, i) {
        imgs.innerHTML += '<img src="' + u + '" style="width:100%; height:200px; object-fit:contain; border-bottom:1px solid #000">'
          + '<div class="muted" style="text-align:right; padding:0 12px">' + (i + 1) + '/' + d.imageFileUrlList.length + '</div>';
      });
    }

    el('d-store').textContent = d.storeName || '판매처 미지정';
    el('d-name').textContent = d.productName || '-';
    el('d-price').textContent = (d.productPrice || 0).toLocaleString() + '원';

    var u = d.userInfo || {};
    if (u.imageFileUrl) el('d-userimg').src = u.imageFileUrl;
    else el('d-userimg').removeAttribute('src');
    renderReaction(u.reactionType || 'NONE');
    el('d-nickname').textContent = u.nickname || '(닉네임 없음)';
    el('d-rank').textContent = RANK[u.jjandolRank] || '-';
    el('d-created').textContent = timeAgo(d.createdAt);
    el('d-view').textContent = d.viewCount;

    el('d-content').textContent = d.content || '';
    el('d-link').textContent = d.purchaseLink || '';
    detailLink = d.purchaseLink || '';
    el('d-like').textContent = d.likeCount;
    el('d-dislike').textContent = d.dislikeCount;

    var c = d.dealPostCommentResponseDto || { comments: [], commentCount: 0 };
    el('d-commentcount').textContent = c.commentCount;
    var box = el('d-comments');
    box.innerHTML = '';
    if ((c.comments || []).length === 0) {
      box.innerHTML = '<div class="pad muted">첫 댓글을 남겨보세요.</div>';
    }
    (c.comments || []).forEach(function (cm) {
      box.appendChild(commentRow(cm, false));
      (cm.replies || []).forEach(function (re) {
        box.appendChild(commentRow(re, true));
      });
    });
  }

  var detailId = null;

  async function react(kind) {
    if (!detailId) return;
    var r = await api('POST', '/api/v1/deal-posts/' + detailId + '/' + kind);
    if (!r.ok) { alert(r.json ? r.json.message : '반응 실패'); return; }

    var d = r.json.data;
    el('d-like').textContent = d.likeCount;
    el('d-dislike').textContent = d.dislikeCount;
    renderReaction(d.reactionType);
  }

  function renderReaction(type) {
    var label = { LIKE: '도움돼요', DISLIKE: '별로예요', NONE: '없음' };
    el('d-reaction').textContent = '내 반응: ' + (label[type] || '없음');
    el('d-likebtn').className = type === 'LIKE' ? 'fill' : '';
    el('d-dislikebtn').className = type === 'DISLIKE' ? 'fill' : '';
  }

  function commentRow(cm, isReply) {
    var div = document.createElement('div');
    div.className = 'noti';
    if (isReply) {
      div.style.paddingLeft = '32px';
      div.style.background = '#f5f5f5';
    }
    div.innerHTML = '<div>' + (isReply ? '└ ' : '') + (cm.userInfo.nickname || '-')
      + ' <span class="tag">' + (RANK[cm.userInfo.jjandolRank] || '-') + '</span></div>'
      + '<div>' + cm.commentInfo.content + '</div>'
      + '<div class="muted">' + timeAgo(cm.commentInfo.createdAt)
      + ' · id ' + cm.commentId + '</div>';

    var actions = document.createElement('div');
    if (!isReply) {
      var reply = document.createElement('button');
      reply.textContent = '답글';
      reply.onclick = function () { writeComment(cm.commentId); };
      actions.appendChild(reply);
    }
    var del = document.createElement('button');
    del.textContent = '삭제';
    del.onclick = function () { removeComment(cm.commentId); };
    actions.appendChild(del);
    div.appendChild(actions);

    return div;
  }

  async function writeComment(parentCommentId) {
    var content = prompt(parentCommentId ? '대댓글 내용' : '댓글 내용');
    if (content === null) return;
    var body = { content: content };
    if (parentCommentId) body.parentCommentId = parentCommentId;

    var r = await api('POST', '/api/v1/deal-posts/' + detailId + '/comments', JSON.stringify(body));
    if (!r.ok) { alert(r.json ? r.json.message : '작성 실패'); return; }
    openDetail(detailId);
  }

  async function removeComment(commentId) {
    var r = await api('DELETE', '/api/v1/deal-posts/' + detailId + '/comments/' + commentId);
    if (!r.ok) { alert(r.json ? r.json.message : '삭제 실패'); return; }
    openDetail(detailId);
  }

  function openPurchaseLink() {
    if (detailLink) window.open(detailLink, '_blank');
  }

  function openShare() {
    go('share');
    loadCategories();
  }

  function countFiles() {
    el('sh-count').textContent = el('sh-files').files.length + '/10';
  }

  async function detectStore() {
    var link = el('sh-link').value;
    if (!link) return;
    var r = await api('POST', '/api/v1/stores/search', JSON.stringify({ purchaseLink: link }));
    if (r.ok && r.json.data) {
      el('sh-store').textContent = r.json.data.storeName;
      el('sh-store').className = 'chip on';
      el('sh-store').dataset.storeId = r.json.data.storeId;
    } else {
      el('sh-store').textContent = '판매처 미확인';
      el('sh-store').className = 'chip';
      el('sh-store').dataset.storeId = '';
    }
  }

  async function share() {
    var payload = {
      purchaseLink: el('sh-link').value,
      productName: el('sh-name').value,
      productPrice: el('sh-price').value ? Number(el('sh-price').value) : null,
      categoryId: el('sh-category').value ? Number(el('sh-category').value) : null,
      storeId: el('sh-store').dataset.storeId ? Number(el('sh-store').dataset.storeId) : null,
      content: el('sh-content').value
    };
    var fd = new FormData();
    fd.append('request', new Blob([JSON.stringify(payload)], { type: 'application/json' }));
    var files = el('sh-files').files;
    for (var i = 0; i < files.length; i++) fd.append('files', files[i]);

    var r = await api('POST', '/api/v1/deal-posts', fd);
    if (!r.ok) { alert(r.json ? r.json.message : '업로드 실패'); return; }
    lastDealPostId = r.json.data.dealPostId;
    runVerification();
  }

  async function runVerification() {
    go('verify');
    el('vf-done').style.display = 'none';
    el('vf-sub').textContent = '게시 내용을 살펴보는 중이에요';
    ['vf-1', 'vf-2', 'vf-3'].forEach(function (id) { el(id).className = ''; });

    var steps = [
      { id: 'vf-1', path: 'link', label: '링크 확인' },
      { id: 'vf-2', path: 'reliability', label: '신뢰도 측정' },
      { id: 'vf-3', path: 'advertisement', label: '광고글 여부 판단' }
    ];

    for (var i = 0; i < steps.length; i++) {
      var s = steps[i];
      el(s.id).className = 'doing';
      el('vf-title').textContent = s.label + ' 중이에요!';

      var r = await api('POST', '/api/v1/deal-posts/' + lastDealPostId + '/verifications/' + s.path);

      if (!r.ok) {
        el(s.id).className = 'fail';
        el('vf-title').textContent = s.label + ' 실패';
        el('vf-sub').textContent = r.json ? r.json.message : '요청 실패';
        return;
      }
      if (!r.json.data.passed) {
        el(s.id).className = 'fail';
        el('vf-title').textContent = s.label + '에서 걸렸어요';
        el('vf-sub').textContent = '이 핫딜은 게시 보류됩니다.';
        return;
      }
      el(s.id).className = 'done';

      if (r.json.data.dealPostStatus === 'ACTIVE') {
        el('vf-title').textContent = '핫딜이 등록됐어요!';
        el('vf-sub').textContent = '';
        el('vf-done').style.display = 'block';
      }
    }
  }

  async function loadNotifications() {
    var r = await api('GET', '/api/v1/notifications');
    var list = el('n-list');
    list.innerHTML = '';
    var items = (r.json && r.json.data) || [];
    if (items.length === 0) {
      list.innerHTML = '<div class="pad muted">받은 알림이 없어요.</div>';
      return;
    }
    list.innerHTML = '<div class="sec">받은 알림</div>';
    items.forEach(function (n) {
      var d = document.createElement('div');
      d.className = 'noti' + (n.read ? '' : ' unread');
      d.innerHTML = '<div class="muted">' + n.notificationType + (n.read ? '' : ' · 안 읽음') + '</div>'
        + '<div>' + n.content + '</div>'
        + '<div class="muted">' + timeAgo(n.pushedAt) + '</div>';
      list.appendChild(d);
    });
  }

  async function loadAlerts() {
    var r = await api('GET', '/api/v1/alerts');
    var data = (r.json && r.json.data) || { categories: [], keywords: [] };

    var cats = el('a-categories');
    cats.innerHTML = '';
    (data.categories || []).forEach(function (c) {
      cats.appendChild(chip(c.categoryName, c.enabled, function () { toggleCategoryAlert(c); }));
    });
    if ((data.categories || []).length === 0) {
      cats.textContent = '카테고리가 DB에 없습니다';
    }

    var keys = el('a-keywords');
    keys.innerHTML = '';
    (data.keywords || []).forEach(function (k) {
      keys.appendChild(chip(k.keyword + ' (삭제)', true, function () { removeAlert(k.alertId); }));
    });
    if ((data.keywords || []).length === 0) {
      keys.innerHTML = '<span class="muted">등록한 키워드가 없어요</span>';
    }
  }

  async function toggleCategoryAlert(c) {
    if (c.enabled) await api('DELETE', '/api/v1/alerts/' + c.alertId);
    else await api('POST', '/api/v1/alerts', JSON.stringify({ categoryId: c.categoryId }));
    loadAlerts();
  }

  async function addKeywordAlert() {
    var k = el('a-keyword').value.trim();
    if (!k) return;
    var r = await api('POST', '/api/v1/alerts', JSON.stringify({ keyword: k }));
    if (!r.ok) alert(r.json ? r.json.message : '등록 실패');
    el('a-keyword').value = '';
    loadAlerts();
  }

  async function removeAlert(alertId) {
    await api('DELETE', '/api/v1/alerts/' + alertId);
    loadAlerts();
  }

  (function init() {
    var q = new URLSearchParams(location.search);
    var justLoggedIn = false;

    if (q.get('accessToken')) {
      localStorage.setItem('accessToken', q.get('accessToken'));
      if (q.get('refreshToken')) localStorage.setItem('refreshToken', q.get('refreshToken'));
      if (q.get('isNewUser')) localStorage.setItem('isNewUser', q.get('isNewUser'));
      history.replaceState(null, '', location.pathname);
      justLoggedIn = true;
    }

    el('devToken').textContent = token() ? '토큰 보유' : '토큰 없음';

    if (!justLoggedIn) {
      go('splash');
      return;
    }

    if (localStorage.getItem('isNewUser') === 'true') {
      go('onboard1');
      return;
    }

    go('home');
    loadDeals();
  })();
</script>
</body>
</html>
